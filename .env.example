# Plantilla de configuración. Cópiala como .env y pon tus valores reales:
#   cp .env.example .env          (Windows: copy .env.example .env)
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Conexión a PostgreSQL: usuario, contraseña, host, puerto y base.
DATABASE_URL=postgresql://epidemia_app:CAMBIAR_CONTRASENA@localhost:5432/simulador_epidemico

# Opcional. Base de las pruebas; sin esta línea se usa la de arriba con "_pruebas"
# al final del nombre. Nunca la misma base: las pruebas dejan rastro en audit_log.
# DATABASE_URL_PRUEBAS=postgresql://epidemia_app:CAMBIAR_CONTRASENA@localhost:5432/simulador_epidemico_pruebas

# Firma de los JWT y de la cookie de sesión. Usa una cadena larga y aleatoria;
# por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Obligatoria: sin ella (o con este valor de ejemplo) la app no arranca.
JWT_SECRET_KEY=CAMBIAR_POR_UNA_CADENA_LARGA_Y_ALEATORIA

# Opcionales, para desarrollar (ver frontend_web/run.py):
# FLASK_DEBUG=1           depurador y recarga automática al guardar
# EPIDEMIA_HOST=0.0.0.0   visible en tu red local; no se combina con FLASK_DEBUG
# EPIDEMIA_PORT=5000
