<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o posterior. La sesión no se respalda ni pasa a otro teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
