<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o posterior. Ni la sesión ni los casos capturados (datos de salud) se respaldan o
     pasan a otro teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
        <exclude domain="database" path="epidemia.db" />
        <exclude domain="database" path="epidemia.db-wal" />
        <exclude domain="database" path="epidemia.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
        <exclude domain="database" path="epidemia.db" />
        <exclude domain="database" path="epidemia.db-wal" />
        <exclude domain="database" path="epidemia.db-shm" />
    </device-transfer>
</data-extraction-rules>
