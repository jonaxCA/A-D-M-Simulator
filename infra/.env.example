# Copia este archivo a infra/.env y llena los valores. infra/.env no se sube al repositorio.
#
# Contraseñas: cadenas largas y aleatorias, una distinta para cada cosa. Genera cada una con
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ese comando solo usa letras, números, "-" y "_". Las contraseñas van dentro de URLs
# (redis://:<contraseña>@redis:6379/0), y una con "@", ":" o "/" rompe la URL.

# --- En uso --------------------------------------------------------------------------------

# Contraseña del Redis del compose. No es la de Memurai, que es otro servidor: usa una nueva.
REDIS_PASSWORD=

# Puerto de Redis en tu máquina, solo en 127.0.0.1. 6380 para no chocar con Memurai (6379).
REDIS_PUERTO_LOCAL=6380

# --- Llegan con los bloques J y L del checklist ---------------------------------------------
# Quítales el # cuando el compose las use. Mientras tanto, nada las lee.

# Firma de los tokens de la API. Distinta de la JWT_SECRET_KEY del .env de la raíz, que es la
# del monolito: si se filtra una, la otra sigue a salvo.
# JWT_SECRET_KEY=

# Contraseña del usuario postgres del contenedor de PostgreSQL.
# POSTGRES_PASSWORD=

# Una contraseña por rol de PostgreSQL de cada servicio (migración 026). El nombre exacto de
# cada variable lo fija el bloque L; por ejemplo:
# DB_PASSWORD_AUTH=
# DB_PASSWORD_REGIONES=

# --- Servicios de escenarios y casos (migración 027) ----------------------------------------
# Un DATABASE_URL por servicio, con su propio rol (svc_<servicio>). La contraseña de cada rol se
# fija fuera del repositorio con ALTER ROLE svc_casos PASSWORD '...'. Dentro de un contenedor,
# "localhost" es el contenedor mismo: para un PostgreSQL en tu máquina usa host.docker.internal.
# Estos servicios usan la base de la demostración; las pruebas de integración, la
# simulador_epidemico_pruebas con su propio compose.
# Perfil vigilancia:
# DATABASE_URL_CASOS=postgresql://svc_casos:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_SINCRONIZACION=postgresql://svc_sincronizacion:<contraseña>@host.docker.internal:5432/simulador_epidemico
# Perfil escenarios:
# DATABASE_URL_ESCENARIOS=postgresql://svc_escenarios:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_INTERVENCIONES=postgresql://svc_intervenciones:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_VALIDACION=postgresql://svc_validacion:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_APROBACION=postgresql://svc_aprobacion:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_ESCENARIOS_XML=postgresql://svc_escenarios_xml:<contraseña>@host.docker.internal:5432/simulador_epidemico

# Cuánto recuerda sincronizacion un lote ya recibido, en segundos (por defecto 7 días).
# SYNC_LOTE_TTL_SECONDS=604800

# Dirección del servicio notificaciones, que usa aprobacion para avisar de una aprobación
# (best-effort: si no responde, la aprobación igual se hace). Todavía no está en este compose.
# SERVICIO_NOTIFICACIONES_URL=http://notificaciones:8000
