# Copia este archivo a infra/.env y llena los valores. infra/.env no se sube al repositorio.
#
# Contraseñas: cadenas largas y aleatorias, una distinta para cada cosa. Genera cada una con
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ese comando solo usa letras, números, "-" y "_". Las contraseñas van dentro de URLs
# (redis://:<contraseña>@redis:6379/0), y una con "@", ":" o "/" rompe la URL.

# --- En uso --------------------------------------------------------------------------------

# Contraseña del Redis del compose. No es la de Memurai, que es otro servidor: usa una nueva.
REDIS_PASSWORD=

# Puerto de Redis en tu máquina, solo en 127.0.0.1. 6380 para no chocar con Memurai (6379).
REDIS_PUERTO_LOCAL=6380

# Firma de los tokens de la API: la misma en todos los servicios, porque auth firma y los
# demás verifican. Distinta de la JWT_SECRET_KEY del .env de la raíz, que es la del monolito:
# si se filtra una, la otra sigue a salvo. Sin ella, ningún servicio arranca.
JWT_SECRET_KEY=

# --- Llegan con el PostgreSQL del compose (bloques J y L) ----------------------------------
# Quítales el # cuando el compose las use. Mientras tanto, nada las lee.

# Contraseña del usuario postgres del contenedor de PostgreSQL.
# POSTGRES_PASSWORD=

# Una contraseña por rol de PostgreSQL de cada servicio (migración 026). El nombre exacto de
# cada variable lo fija el bloque L; por ejemplo:
# DB_PASSWORD_AUTH=
# DB_PASSWORD_REGIONES=

# --- La base de cada servicio --------------------------------------------------------------
# Un DATABASE_URL por servicio, con su propio rol (svc_<servicio>, migraciones 026 y 027). La contraseña de cada rol se
# fija fuera del repositorio con ALTER ROLE svc_casos PASSWORD '...'. Dentro de un contenedor,
# "localhost" es el contenedor mismo: para un PostgreSQL en tu máquina usa host.docker.internal.
# Estos servicios usan la base de la demostración; las pruebas de integración, la
# simulador_epidemico_pruebas con su propio compose.
# Perfil identidad:
# DATABASE_URL_AUTH=postgresql://svc_auth:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_SESIONES=postgresql://svc_sesiones:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_USUARIOS=postgresql://svc_usuarios:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_ROLES=postgresql://svc_roles:<contraseña>@host.docker.internal:5432/simulador_epidemico
# Perfil catalogos:
# DATABASE_URL_ENFERMEDADES=postgresql://svc_enfermedades:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_PARAMETROS=postgresql://svc_parametros:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_REGIONES=postgresql://svc_regiones:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_POBLACION=postgresql://svc_poblacion:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_TIPOS_INTERVENCION=postgresql://svc_tipos_intervencion:<contraseña>@host.docker.internal:5432/simulador_epidemico
# Perfil vigilancia:
# DATABASE_URL_CASOS=postgresql://svc_casos:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_SINCRONIZACION=postgresql://svc_sincronizacion:<contraseña>@host.docker.internal:5432/simulador_epidemico
# Perfil escenarios:
# DATABASE_URL_ESCENARIOS=postgresql://svc_escenarios:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_INTERVENCIONES=postgresql://svc_intervenciones:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_VALIDACION=postgresql://svc_validacion:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_APROBACION=postgresql://svc_aprobacion:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_ESCENARIOS_XML=postgresql://svc_escenarios_xml:<contraseña>@host.docker.internal:5432/simulador_epidemico
# Perfil simulacion (sus roles llegan con la migración que sigue; mientras, cualquier rol que
# pueda leer las corridas y sus resultados):
# DATABASE_URL_COMPARACION=postgresql://<rol>:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_PARETO=postgresql://<rol>:<contraseña>@host.docker.internal:5432/simulador_epidemico
# Perfil analitica:
# DATABASE_URL_INDICADORES=postgresql://svc_indicadores:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_SERIES=postgresql://svc_series:<contraseña>@host.docker.internal:5432/simulador_epidemico
# DATABASE_URL_ZONAS=postgresql://svc_zonas:<contraseña>@host.docker.internal:5432/simulador_epidemico

# Cuánto recuerda sincronizacion un lote ya recibido, en segundos (por defecto 7 días).
# SYNC_LOTE_TTL_SECONDS=604800

# Dirección del servicio notificaciones, que usa aprobacion para avisar de una aprobación
# (best-effort: si no responde, la aprobación igual se hace). Todavía no está en este compose.
# SERVICIO_NOTIFICACIONES_URL=http://notificaciones:8000
