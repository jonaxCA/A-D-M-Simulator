# Plantilla de infra/.env.gpu-remoto, para el simulador de abm-gpu en tu PC
# (infra/docker-compose.gpu-remoto.yml). Cópiala como infra/.env.gpu-remoto, que no entra a git,
# y pon los valores de infra/.env de la máquina de GCP. Los copias tú: son secretos.

# Los mismos de infra/.env de la máquina.
JWT_SECRET_KEY=CAMBIAR_POR_EL_DE_LA_MAQUINA
REDIS_PASSWORD=CAMBIAR_POR_EL_DE_LA_MAQUINA
DB_PASSWORD_SIMULADOR=CAMBIAR_POR_EL_DE_LA_MAQUINA
MONGO_PASSWORD=CAMBIAR_POR_EL_DE_LA_MAQUINA
POSTGRES_DB=simulador_epidemico

# notificaciones detrás de nginx, con el dominio de la máquina.
SERVICIO_NOTIFICACIONES_URL=https://<ip-con-guiones>.sslip.io/notificaciones

# Los puertos del túnel en tu PC (python infra/tunel_gpu.py). Cámbialos solo si cambiaste los
# del túnel.
TUNEL_REDIS=16380
TUNEL_POSTGRES=15433
TUNEL_MONGO=17018
