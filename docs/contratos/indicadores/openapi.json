{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - indicadores",
    "version": "0.1.0",
    "description": "Indicadores del tablero y resumen de situación por enfermedad. Públicos, como el tablero del monolito."
  },
  "servers": [
    {
      "url": "http://localhost:5251"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/dashboard/indicators": {
      "get": {
        "summary": "Indicadores del tablero",
        "operationId": "indicadores_tablero",
        "description": "Casos activos, tasa de incidencia por 100k, zonas en riesgo y simulaciones activas, con su variación semanal.",
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "casos_activos": 0,
                  "casos_pct": 0.0,
                  "tasa_incidencia": 0.0,
                  "tasa_pct": 0.0,
                  "zonas_en_riesgo": 0,
                  "simulaciones_activas": 70
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "indicadores"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real (listas recortadas)",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<indicadores><casos_activos tipo=\"numero\">0</casos_activos><casos_pct tipo=\"numero\">0.0</casos_pct><tasa_incidencia tipo=\"numero\">0.0</tasa_incidencia><tasa_pct tipo=\"numero\">0.0</tasa_pct><zonas_en_riesgo tipo=\"numero\">0</zonas_en_riesgo><simulaciones_activas tipo=\"numero\">70</simulaciones_activas></indicadores>\n"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          }
        }
      }
    },
    "/api/v1/dashboard/situation": {
      "get": {
        "summary": "Resumen de situación",
        "operationId": "resumen_situacion",
        "description": "Casos de la última semana por enfermedad, con su tendencia (estable, alerta o critico).",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "description": "Número de enfermedades (por omisión 5)"
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "enfermedades": []
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "situacion"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real (listas recortadas)",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<situacion><enfermedades /></situacion>\n"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          }
        }
      }
    },
    "/api/v1/dashboard/curve": {
      "get": {
        "summary": "Curva del tablero",
        "operationId": "curva_tablero",
        "description": "Casos por día de los últimos 30 días, de todas las enfermedades, en los municipios de Nuevo León: la gráfica del tablero público. Agregada, sin datos de personas; pública como las demás rutas del tablero. Caché de 60 s.",
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "dias": 30,
                  "puntos": [
                    {
                      "fecha": "2026-11-17",
                      "total": 42
                    },
                    {
                      "fecha": "2026-11-18",
                      "total": 37
                    }
                  ]
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "curva"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<curva><dias tipo=\"numero\">30</dias><puntos><punto><fecha>2026-11-17</fecha><total tipo=\"numero\">42</total></punto><punto><fecha>2026-11-18</fecha><total tipo=\"numero\">37</total></punto></puntos></curva>"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Redis no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          },
          "429": {
            "description": "Demasiadas peticiones (LIMITE_EXCEDIDO). La cabecera Retry-After trae los segundos de espera.",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dashboard/situation/export": {
      "get": {
        "summary": "Exportar el resumen de situación",
        "operationId": "exportar_situacion",
        "description": "El mismo resumen que resumen_situacion, para exportarlo (el CSV lo arma el cliente). Pide sesión para que la bitácora registre EXPORT sobre reports (resumen_situacion) con quién exportó. Cualquier rol con sesión.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "description": "Cuántas enfermedades, de 1 a 20. Por omisión 5.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "enfermedades": []
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "situacion"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<situacion><enfermedades /></situacion>"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Rol sin permiso (PERMISO_INSUFICIENTE): solo cualquier rol con sesión. Queda en la bitácora como PERMISSION_DENIED."
          },
          "422": {
            "description": "limit no es un entero de 1 a 20 (DATOS_INVALIDOS)"
          },
          "503": {
            "description": "Redis no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          },
          "429": {
            "description": "Demasiadas peticiones (LIMITE_EXCEDIDO). La cabecera Retry-After trae los segundos de espera.",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
