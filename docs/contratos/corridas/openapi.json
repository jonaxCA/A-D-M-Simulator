{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - corridas",
    "version": "0.1.0",
    "description": "Lanza, consulta y cancela corridas. Lanzar crea la corrida en PostgreSQL (encolado) y la mete en la cola de Redis; la ejecuta el servicio simulador. Solo se simula una versión aprobada."
  },
  "servers": [
    {
      "url": "http://localhost:5241"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token del servicio auth, con sesión activa en Redis."
      }
    }
  },
  "paths": {
    "/api/v1/runs": {
      "post": {
        "summary": "Lanzar una corrida",
        "operationId": "lanzar_corrida",
        "description": "ANALISTA y ADMINISTRADOR, como la pantalla Simulaciones del monolito. Responde 202 con el id: el avance se sigue con GET /api/v1/runs/{run_id}. Un candado en Redis por versión evita que un doble clic lance dos corridas.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "scenario_version_id"
                ],
                "properties": {
                  "scenario_version_id": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Versión aprobada del escenario"
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "Opcional; sin ella se elige una al azar"
                  },
                  "forzar_error": {
                    "type": "boolean",
                    "default": false,
                    "description": "Solo cuenta para ADMINISTRADOR; para otro rol se ignora"
                  }
                }
              },
              "example": {
                "scenario_version_id": 11,
                "seed": 982314
              }
            },
            "application/xml": {
              "schema": {
                "type": "object",
                "required": [
                  "scenario_version_id"
                ],
                "properties": {
                  "scenario_version_id": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Versión aprobada del escenario"
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "Opcional; sin ella se elige una al azar"
                  },
                  "forzar_error": {
                    "type": "boolean",
                    "default": false,
                    "description": "Solo cuenta para ADMINISTRADOR; para otro rol se ignora"
                  }
                },
                "xml": {
                  "name": "solicitud"
                }
              },
              "examples": {
                "peticion": {
                  "value": "<?xml version='1.0' encoding='utf-8'?>\n<solicitud><scenario_version_id tipo=\"numero\">11</scenario_version_id><seed tipo=\"numero\">982314</seed></solicitud>\n"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": 44,
                  "batch_id": 44,
                  "scenario_version_id": 11,
                  "seed": 982314,
                  "forzar_error": false,
                  "status": "encolado"
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "corrida"
                  }
                },
                "examples": {
                  "respuesta": {
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<corrida><id tipo=\"numero\">44</id><batch_id tipo=\"numero\">44</batch_id><scenario_version_id tipo=\"numero\">11</scenario_version_id><seed tipo=\"numero\">982314</seed><forzar_error tipo=\"booleano\">false</forzar_error><status>encolado</status></corrida>\n"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta token, es inválido, venció o la sesión se cerró"
          },
          "403": {
            "description": "El rol no puede usar esta ruta"
          },
          "503": {
            "description": "Redis no está disponible"
          },
          "400": {
            "description": "JSON o XML ilegible"
          },
          "404": {
            "description": "No existe la versión"
          },
          "409": {
            "description": "La versión no está aprobada, o ya se está lanzando una corrida de ella"
          },
          "415": {
            "description": "Content-Type no soportado"
          },
          "422": {
            "description": "scenario_version_id, seed o forzar_error inválidos"
          }
        }
      },
      "get": {
        "summary": "Corridas recientes",
        "operationId": "listar_corridas",
        "description": "Las más recientes de cualquier escenario, como la lista de la pantalla Simulaciones. ANALISTA, EPIDEMIOLOGO y ADMINISTRADOR.",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "total": 2,
                  "corridas": [
                    {
                      "id": 43,
                      "status": "ejecutando",
                      "seed": 982314,
                      "queued_at": "2026-10-20T15:03:00+00:00",
                      "started_at": "2026-10-20T15:03:00+00:00",
                      "finished_at": null,
                      "error_message": null,
                      "scenario_id": 3,
                      "version_number": 2,
                      "scenario_name": "Brote de influenza en Monterrey",
                      "requested_by_username": "ana"
                    },
                    {
                      "id": 41,
                      "status": "fallido",
                      "seed": 7,
                      "queued_at": "2026-10-20T14:00:00+00:00",
                      "started_at": "2026-10-20T14:00:00+00:00",
                      "finished_at": "2026-10-20T14:00:00+00:00",
                      "error_message": "Error forzado de prueba: se solicito explicitamente desde la pantalla de simulaciones (opcion visible solo para ADMINISTRADOR). Demuestra el camino encolado -> ejecutando -> fallido sin depender de que un escenario real este incompleto.",
                      "scenario_id": 3,
                      "version_number": 2,
                      "scenario_name": "Brote de influenza en Monterrey",
                      "requested_by_username": "ana"
                    }
                  ]
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "listado"
                  }
                },
                "examples": {
                  "respuesta": {
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<listado><total tipo=\"numero\">2</total><corridas><corrida><id tipo=\"numero\">43</id><status>ejecutando</status><seed tipo=\"numero\">982314</seed><queued_at>2026-10-20T15:03:00+00:00</queued_at><started_at>2026-10-20T15:03:00+00:00</started_at><finished_at nil=\"true\" /><error_message nil=\"true\" /><scenario_id tipo=\"numero\">3</scenario_id><version_number tipo=\"numero\">2</version_number><scenario_name>Brote de influenza en Monterrey</scenario_name><requested_by_username>ana</requested_by_username></corrida><corrida><id tipo=\"numero\">41</id><status>fallido</status><seed tipo=\"numero\">7</seed><queued_at>2026-10-20T14:00:00+00:00</queued_at><started_at>2026-10-20T14:00:00+00:00</started_at><finished_at>2026-10-20T14:00:00+00:00</finished_at><error_message>Error forzado de prueba: se solicito explicitamente desde la pantalla de simulaciones (opcion visible solo para ADMINISTRADOR). Demuestra el camino encolado -&gt; ejecutando -&gt; fallido sin depender de que un escenario real este incompleto.</error_message><scenario_id tipo=\"numero\">3</scenario_id><version_number tipo=\"numero\">2</version_number><scenario_name>Brote de influenza en Monterrey</scenario_name><requested_by_username>ana</requested_by_username></corrida></corridas></listado>\n"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta token, es inválido, venció o la sesión se cerró"
          },
          "403": {
            "description": "El rol no puede usar esta ruta"
          },
          "503": {
            "description": "Redis no está disponible"
          },
          "422": {
            "description": "limit inválido"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}": {
      "get": {
        "summary": "Estado y avance de una corrida",
        "operationId": "consultar_corrida",
        "description": "progress sale de Redis (job:<id>:progress, lo escribe el simulador) mientras la corrida no termina, y de PostgreSQL después. terminal es true en completado, fallido y cancelado. ANALISTA, EPIDEMIOLOGO y ADMINISTRADOR.",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Id de la corrida"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": 43,
                  "batch_id": 43,
                  "scenario_version_id": 11,
                  "seed": 982314,
                  "status": "ejecutando",
                  "progress": 30,
                  "engine_version": "python-ref-0.1",
                  "queued_at": "2026-10-20T15:00:00+00:00",
                  "started_at": "2026-10-20T15:03:00+00:00",
                  "finished_at": null,
                  "error_message": null,
                  "requested_by": 5,
                  "version_number": 2,
                  "scenario_id": 3,
                  "version_status": "aprobado",
                  "population_size": 200000,
                  "horizon_days": 5,
                  "initial_infected": 100,
                  "scenario_name": "Brote de influenza en Monterrey",
                  "disease_id": 1,
                  "disease_name": "Influenza",
                  "region_id": 9,
                  "region_name": "Monterrey",
                  "requested_by_username": "ana",
                  "requested_by_nombre": "Ana Analista",
                  "terminal": false
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "corrida"
                  }
                },
                "examples": {
                  "respuesta": {
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<corrida><id tipo=\"numero\">43</id><batch_id tipo=\"numero\">43</batch_id><scenario_version_id tipo=\"numero\">11</scenario_version_id><seed tipo=\"numero\">982314</seed><status>ejecutando</status><progress tipo=\"numero\">30</progress><engine_version>python-ref-0.1</engine_version><queued_at>2026-10-20T15:00:00+00:00</queued_at><started_at>2026-10-20T15:03:00+00:00</started_at><finished_at nil=\"true\" /><error_message nil=\"true\" /><requested_by tipo=\"numero\">5</requested_by><version_number tipo=\"numero\">2</version_number><scenario_id tipo=\"numero\">3</scenario_id><version_status>aprobado</version_status><population_size tipo=\"numero\">200000</population_size><horizon_days tipo=\"numero\">5</horizon_days><initial_infected tipo=\"numero\">100</initial_infected><scenario_name>Brote de influenza en Monterrey</scenario_name><disease_id tipo=\"numero\">1</disease_id><disease_name>Influenza</disease_name><region_id tipo=\"numero\">9</region_id><region_name>Monterrey</region_name><requested_by_username>ana</requested_by_username><requested_by_nombre>Ana Analista</requested_by_nombre><terminal tipo=\"booleano\">false</terminal></corrida>\n"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta token, es inválido, venció o la sesión se cerró"
          },
          "403": {
            "description": "El rol no puede usar esta ruta"
          },
          "503": {
            "description": "Redis no está disponible"
          },
          "404": {
            "description": "No existe la corrida"
          },
          "422": {
            "description": "Id inválido"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/cancel": {
      "post": {
        "summary": "Cancelar una corrida encolada",
        "operationId": "cancelar_corrida",
        "description": "Solo una corrida que nadie ha empezado (encolado). ANALISTA y ADMINISTRADOR (simulations.delete). Queda en la bitácora como CANCEL.",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Id de la corrida"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": 44,
                  "status": "cancelado"
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "corrida"
                  }
                },
                "examples": {
                  "respuesta": {
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<corrida><id tipo=\"numero\">44</id><status>cancelado</status></corrida>\n"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta token, es inválido, venció o la sesión se cerró"
          },
          "403": {
            "description": "El rol no puede usar esta ruta"
          },
          "503": {
            "description": "Redis no está disponible"
          },
          "404": {
            "description": "No existe la corrida"
          },
          "409": {
            "description": "La corrida ya no está encolada"
          },
          "422": {
            "description": "Id inválido"
          }
        }
      }
    }
  }
}
