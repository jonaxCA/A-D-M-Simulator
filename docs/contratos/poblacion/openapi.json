{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - poblacion",
    "version": "0.1.0",
    "description": "Servicio de poblacion del sistema de respuesta a epidemias. Los ejemplos están en docs/contratos/poblacion/ejemplos."
  },
  "servers": [
    {
      "url": "http://localhost:5214"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/regions/{region_id}/population": {
      "get": {
        "summary": "Consultar población municipal",
        "operationId": "consultar_poblaci_n_municipal",
        "parameters": [
          {
            "in": "path",
            "name": "region_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "region_id": 4,
                  "population": 643143,
                  "population_60plus": 85216
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "poblacion"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<poblacion><region_id tipo=\"numero\">4</region_id><population tipo=\"numero\">643143</population><population_60plus tipo=\"numero\">85216</population_60plus></poblacion>\n"
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible"
          }
        }
      },
      "put": {
        "summary": "Corregir población municipal",
        "operationId": "corregir_poblaci_n_municipal",
        "description": "Solo ADMINISTRADOR. expected_population es el valor que se leyó antes de editar; si otra persona lo cambió, responde 409.",
        "parameters": [
          {
            "in": "path",
            "name": "region_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "municipio": "Guadalupe",
                  "poblacion_antes": 643143,
                  "poblacion_despues": 645020,
                  "poblacion_60": 85216,
                  "estado_actualizado": true,
                  "municipios_sin_poblacion": 0
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "poblacion"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<poblacion><municipio>Guadalupe</municipio><poblacion_antes tipo=\"numero\">643143</poblacion_antes><poblacion_despues tipo=\"numero\">645020</poblacion_despues><poblacion_60 tipo=\"numero\">85216</poblacion_60><estado_actualizado tipo=\"booleano\">true</estado_actualizado><municipios_sin_poblacion tipo=\"numero\">0</municipios_sin_poblacion></poblacion>\n"
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "population",
                  "expected_population",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "population": {
                    "type": "integer"
                  },
                  "expected_population": {
                    "type": "integer"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "population": 645020,
                "expected_population": 643143,
                "reason": "Conteo municipal 2026"
              }
            },
            "application/xml": {
              "schema": {
                "type": "object",
                "required": [
                  "population",
                  "expected_population",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "population": {
                    "type": "integer"
                  },
                  "expected_population": {
                    "type": "integer"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/regions/{region_id}/age-groups": {
      "get": {
        "summary": "Consultar grupos de edad",
        "operationId": "consultar_grupos_de_edad",
        "description": "Pendiente: el servicio usa las claves 0-19 y 80+ como etiqueta y su XML queda mal formado. El ejemplo XML muestra la forma válida con <entrada clave=\"...\">; mientras se corrige epidemia_comun.formatos, usa JSON.",
        "parameters": [
          {
            "in": "path",
            "name": "region_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "grupos": {
                    "0-19": 186512,
                    "20-39": 196140,
                    "40-59": 159481,
                    "60-79": 74389,
                    "80+": 10827
                  },
                  "edad_no_especificada": 15794
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "grupos_edad"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<grupos_edad><grupos><entrada clave=\"0-19\" tipo=\"numero\">186512</entrada><entrada clave=\"20-39\" tipo=\"numero\">196140</entrada><entrada clave=\"40-59\" tipo=\"numero\">159481</entrada><entrada clave=\"60-79\" tipo=\"numero\">74389</entrada><entrada clave=\"80+\" tipo=\"numero\">10827</entrada></grupos><edad_no_especificada tipo=\"numero\">15794</edad_no_especificada></grupos_edad>\n"
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible"
          }
        }
      },
      "put": {
        "summary": "Corregir grupos de edad",
        "operationId": "corregir_grupos_de_edad",
        "description": "Solo ADMINISTRADOR. groups trae las cinco bandas; su suma debe conservar la población con edad declarada. expected_groups trae las cinco bandas y edad_no_especificada tal como se leyeron; si otra persona las cambió, responde 409.",
        "parameters": [
          {
            "in": "path",
            "name": "region_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "municipio": "Guadalupe",
                  "population_60plus": 85216,
                  "estado_actualizado": true
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "grupos_edad"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<grupos_edad><municipio>Guadalupe</municipio><population_60plus tipo=\"numero\">85216</population_60plus><estado_actualizado tipo=\"booleano\">true</estado_actualizado></grupos_edad>\n"
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "groups",
                  "expected_groups",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "groups": {
                    "type": "object"
                  },
                  "expected_groups": {
                    "type": "object"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "groups": {
                  "0-19": 186500,
                  "20-39": 196152,
                  "40-59": 159481,
                  "60-79": 74389,
                  "80+": 10827
                },
                "expected_groups": {
                  "0-19": 186512,
                  "20-39": 196140,
                  "40-59": 159481,
                  "60-79": 74389,
                  "80+": 10827,
                  "edad_no_especificada": 15794
                },
                "reason": "Reclasificación de registros 2026"
              }
            },
            "application/xml": {
              "schema": {
                "type": "object",
                "required": [
                  "groups",
                  "expected_groups",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "groups": {
                    "type": "object"
                  },
                  "expected_groups": {
                    "type": "object"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  }
}
