          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          }
        },
        "description": "Los supuestos de efectividad del tipo: el general primero y luego por enfermedad. No cambian lo que se simula: cada intervención lleva su propio valor."
      },
