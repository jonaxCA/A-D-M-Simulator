{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - tipos-intervencion",
    "version": "0.1.0",
    "description": "Catálogo de tipos de intervención con el esquema de sus parámetros y sus supuestos de efectividad, con fuente o marca de supuesto (D58). Leer es público; los supuestos los cambian EPIDEMIOLOGO y ADMINISTRADOR. Sus reglas ya no viven en backend_web."
  },
  "servers": [
    {
      "url": "http://localhost:5215"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/intervention-types": {
      "get": {
        "summary": "Listar tipos de intervención",
        "operationId": "listar_tipos_intervencion",
        "description": "Tipos activos, ordenados por nombre, con su param_schema (JSON Schema).",
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "total": 6,
                  "tipos": [
                    {
                      "id": 5,
                      "code": "VACUNACION",
                      "name": "Campania de vacunacion",
                      "description": "Reduce la susceptibilidad de los agentes seleccionados, con eficacia parcial y criterio de prioridad.",
                      "target_layer": "todas",
                      "primitive": "node_attr",
                      "param_schema": {
                        "type": "object",
                        "required": [
                          "eficacia",
                          "dosis_diarias"
                        ],
                        "properties": {
                          "eficacia": {
                            "type": "number",
                            "maximum": 1,
                            "minimum": 0
                          },
                          "prioridad": {
                            "enum": [
                              "edad_desc",
                              "zona",
                              "ocupacion"
                            ],
                            "type": "string"
                          },
                          "edad_minima": {
                            "type": "integer",
                            "maximum": 120,
                            "minimum": 0
                          },
                          "dosis_diarias": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      },
                      "unit_cost": null,
                      "cost_unit": "por_dosis",
                      "cost_source": null,
                      "cost_is_assumption": true
                    },
                    {
                      "id": 4,
                      "code": "CIERRE_TRABAJO",
                      "name": "Cierre de centros de trabajo",
                      "description": "Desactiva o atenua la capa trabajo para los sectores indicados.",
                      "target_layer": "trabajo",
                      "primitive": "edge_modifier",
                      "param_schema": {
                        "type": "object",
                        "properties": {
                          "sectores": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "reduccion": {
                            "type": "number",
                            "default": 1.0,
                            "maximum": 1,
                            "minimum": 0
                          }
                        }
                      },
                      "unit_cost": null,
                      "cost_unit": "por_habitante_dia",
                      "cost_source": null,
                      "cost_is_assumption": true
                    },
                    {
                      "id": 1,
                      "code": "CIERRE_ESCUELAS",
                      "name": "Cierre de escuelas",
                      "description": "Desactiva la capa escuela a partir del dia indicado.",
                      "target_layer": "escuela",
                      "primitive": "edge_modifier",
                      "param_schema": {
                        "type": "object",
                        "properties": {
                          "reduccion": {
                            "type": "number",
                            "default": 1.0,
                            "maximum": 1,
                            "minimum": 0
                          }
                        }
                      },
                      "unit_cost": null,
                      "cost_unit": "por_habitante_dia",
                      "cost_source": null,
                      "cost_is_assumption": true
                    }
                  ]
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "catalogo_tipos_intervencion"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real (listas recortadas)",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<catalogo_tipos_intervencion><total tipo=\"numero\">6</total><tipos><tipo><id tipo=\"numero\">5</id><code>VACUNACION</code><name>Campania de vacunacion</name><description>Reduce la susceptibilidad de los agentes seleccionados, con eficacia parcial y criterio de prioridad.</description><target_layer>todas</target_layer><primitive>node_attr</primitive><param_schema><type>object</type><required><item>eficacia</item><item>dosis_diarias</item></required><properties><eficacia><type>number</type><maximum tipo=\"numero\">1</maximum><minimum tipo=\"numero\">0</minimum></eficacia><prioridad><enum><item>edad_desc</item><item>zona</item><item>ocupacion</item></enum><type>string</type></prioridad><edad_minima><type>integer</type><maximum tipo=\"numero\">120</maximum><minimum tipo=\"numero\">0</minimum></edad_minima><dosis_diarias><type>integer</type><minimum tipo=\"numero\">1</minimum></dosis_diarias></properties></param_schema><unit_cost nil=\"true\" /><cost_unit>por_dosis</cost_unit><cost_source nil=\"true\" /><cost_is_assumption tipo=\"booleano\">true</cost_is_assumption></tipo><tipo><id tipo=\"numero\">4</id><code>CIERRE_TRABAJO</code><name>Cierre de centros de trabajo</name><description>Desactiva o atenua la capa trabajo para los sectores indicados.</description><target_layer>trabajo</target_layer><primitive>edge_modifier</primitive><param_schema><type>object</type><properties><sectores><type>array</type><items><type>string</type></items></sectores><reduccion><type>number</type><default tipo=\"numero\">1.0</default><maximum tipo=\"numero\">1</maximum><minimum tipo=\"numero\">0</minimum></reduccion></properties></param_schema><unit_cost nil=\"true\" /><cost_unit>por_habitante_dia</cost_unit><cost_source nil=\"true\" /><cost_is_assumption tipo=\"booleano\">true</cost_is_assumption></tipo><tipo><id tipo=\"numero\">1</id><code>CIERRE_ESCUELAS</code><name>Cierre de escuelas</name><description>Desactiva la capa escuela a partir del dia indicado.</description><target_layer>escuela</target_layer><primitive>edge_modifier</primitive><param_schema><type>object</type><properties><reduccion><type>number</type><default tipo=\"numero\">1.0</default><maximum tipo=\"numero\">1</maximum><minimum tipo=\"numero\">0</minimum></reduccion></properties></param_schema><unit_cost nil=\"true\" /><cost_unit>por_habitante_dia</cost_unit><cost_source nil=\"true\" /><cost_is_assumption tipo=\"booleano\">true</cost_is_assumption></tipo></tipos></catalogo_tipos_intervencion>\n"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          }
        }
      }
    },
    "/api/v1/intervention-types/{code}": {
      "get": {
        "summary": "Consultar tipo de intervención",
        "operationId": "consultar_tipo_intervencion",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "description": "Código del tipo, por ejemplo CIERRE_ESCUELAS",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,49}$"
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": 5,
                  "code": "VACUNACION",
                  "name": "Campania de vacunacion",
                  "description": "Reduce la susceptibilidad de los agentes seleccionados, con eficacia parcial y criterio de prioridad.",
                  "target_layer": "todas",
                  "primitive": "node_attr",
                  "param_schema": {
                    "type": "object",
                    "required": [
                      "eficacia",
                      "dosis_diarias"
                    ],
                    "properties": {
                      "eficacia": {
                        "type": "number",
                        "maximum": 1,
                        "minimum": 0
                      },
                      "prioridad": {
                        "enum": [
                          "edad_desc",
                          "zona",
                          "ocupacion",
                          "aleatorio"
                        ],
                        "type": "string"
                      },
                      "edad_minima": {
                        "type": "integer",
                        "maximum": 120,
                        "minimum": 0
                      },
                      "dosis_diarias": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  "unit_cost": null,
                  "cost_unit": "por_dosis",
                  "cost_source": null,
                  "cost_is_assumption": true,
                  "person_days_per_unit": null,
                  "person_days_source": null,
                  "person_days_is_assumption": true,
                  "efectividad": [
                    {
                      "parametro": "eficacia",
                      "enfermedad": "INFLUENZA_ESTACIONAL",
                      "valor": 0.59,
                      "min": 0.51,
                      "max": 0.67,
                      "fuente": "Osterholm et al. 2012, Lancet Infect Dis 12(1):36-44: eficacia agrupada de la vacuna trivalente inactivada en adultos, 59% (IC95% 51-67), contra influenza confirmada por RT-PCR o cultivo. El motor la aplica como protección completa de una fracción de los vacunados. doi:10.1016/S1473-3099(11)70295-X",
                      "supuesto": false,
                      "updated_by": null,
                      "updated_at": "2026-11-23T10:00:00+00:00"
                    },
                    {
                      "parametro": "eficacia",
                      "enfermedad": "SARS_COV_2_ANCESTRAL",
                      "valor": 0.95,
                      "min": 0.903,
                      "max": 0.976,
                      "fuente": "Polack et al. 2020, N Engl J Med 383(27):2603-2615: la vacuna BNT162b2 tuvo 95% de eficacia contra COVID-19 desde 7 días después de la segunda dosis (intervalo creíble 95%: 90.3-97.6). El motor la aplica como protección completa de una fracción de los vacunados. doi:10.1056/NEJMoa2034577",
                      "supuesto": false,
                      "updated_by": null,
                      "updated_at": "2026-11-23T10:00:00+00:00"
                    }
                  ]
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "tipo"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real (listas recortadas)",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<tipo><id tipo=\"numero\">5</id><code>VACUNACION</code><name>Campania de vacunacion</name><description>Reduce la susceptibilidad de los agentes seleccionados, con eficacia parcial y criterio de prioridad.</description><target_layer>todas</target_layer><primitive>node_attr</primitive><param_schema><type>object</type><required><item>eficacia</item><item>dosis_diarias</item></required><properties><eficacia><type>number</type><maximum tipo=\"numero\">1</maximum><minimum tipo=\"numero\">0</minimum></eficacia><prioridad><enum><item>edad_desc</item><item>zona</item><item>ocupacion</item><item>aleatorio</item></enum><type>string</type></prioridad><edad_minima><type>integer</type><maximum tipo=\"numero\">120</maximum><minimum tipo=\"numero\">0</minimum></edad_minima><dosis_diarias><type>integer</type><minimum tipo=\"numero\">1</minimum></dosis_diarias></properties></param_schema><unit_cost nil=\"true\" /><cost_unit>por_dosis</cost_unit><cost_source nil=\"true\" /><cost_is_assumption tipo=\"booleano\">true</cost_is_assumption><person_days_per_unit nil=\"true\" /><person_days_source nil=\"true\" /><person_days_is_assumption tipo=\"booleano\">true</person_days_is_assumption><efectividad><supuesto><parametro>eficacia</parametro><enfermedad>INFLUENZA_ESTACIONAL</enfermedad><valor tipo=\"numero\">0.59</valor><min tipo=\"numero\">0.51</min><max tipo=\"numero\">0.67</max><fuente>Osterholm et al. 2012, Lancet Infect Dis 12(1):36-44: eficacia agrupada de la vacuna trivalente inactivada en adultos, 59% (IC95% 51-67), contra influenza confirmada por RT-PCR o cultivo. El motor la aplica como protección completa de una fracción de los vacunados. doi:10.1016/S1473-3099(11)70295-X</fuente><supuesto tipo=\"booleano\">false</supuesto><updated_by nil=\"true\" /><updated_at>2026-11-23T10:00:00+00:00</updated_at></supuesto><supuesto><parametro>eficacia</parametro><enfermedad>SARS_COV_2_ANCESTRAL</enfermedad><valor tipo=\"numero\">0.95</valor><min tipo=\"numero\">0.903</min><max tipo=\"numero\">0.976</max><fuente>Polack et al. 2020, N Engl J Med 383(27):2603-2615: la vacuna BNT162b2 tuvo 95% de eficacia contra COVID-19 desde 7 días después de la segunda dosis (intervalo creíble 95%: 90.3-97.6). El motor la aplica como protección completa de una fracción de los vacunados. doi:10.1056/NEJMoa2034577</fuente><supuesto tipo=\"booleano\">false</supuesto><updated_by nil=\"true\" /><updated_at>2026-11-23T10:00:00+00:00</updated_at></supuesto></efectividad></tipo>\n"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
