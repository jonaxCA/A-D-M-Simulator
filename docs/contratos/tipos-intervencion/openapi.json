          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          }
        },
        "description": "Un tipo activo, con su param_schema, su costo y sus supuestos de efectividad (D58): valor de referencia, rango, fuente y marca de supuesto, general o por enfermedad."
      }
    },
    "/api/v1/intervention-types/{code}/effectiveness": {
      "get": {
        "summary": "Supuestos de efectividad de un tipo",
        "operationId": "efectividad_tipo",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "code": "CUBREBOCAS",
                  "total": 1,
                  "efectividad": [
                    {
                      "parametro": "eficacia",
                      "enfermedad": null,
                      "valor": 0.85,
                      "min": 0.66,
                      "max": 0.93,
                      "fuente": "DERIVADO POR EL EQUIPO de Chu et al. 2020, Lancet 395(10242):1973-1987: el uso de cubrebocas se asoció con menos infecciones (aOR 0.15, IC95% 0.07-0.34; certeza baja), sobre todo en entornos de atención médica y con respiradores N95. La eficacia se toma como 1 - aOR; con cubrebocas de tela o quirúrgicos en la comunidad el efecto esperado es menor. doi:10.1016/S0140-6736(20)31142-9",
                      "supuesto": true,
                      "updated_by": null,
                      "updated_at": "2026-11-23T10:00:00+00:00"
                    }
                  ]
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "efectividad_tipo"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real (listas recortadas)",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<efectividad_tipo><code>CUBREBOCAS</code><total tipo=\"numero\">1</total><efectividad><supuesto><parametro>eficacia</parametro><enfermedad nil=\"true\" /><valor tipo=\"numero\">0.85</valor><min tipo=\"numero\">0.66</min><max tipo=\"numero\">0.93</max><fuente>DERIVADO POR EL EQUIPO de Chu et al. 2020, Lancet 395(10242):1973-1987: el uso de cubrebocas se asoció con menos infecciones (aOR 0.15, IC95% 0.07-0.34; certeza baja), sobre todo en entornos de atención médica y con respiradores N95. La eficacia se toma como 1 - aOR; con cubrebocas de tela o quirúrgicos en la comunidad el efecto esperado es menor. doi:10.1016/S0140-6736(20)31142-9</fuente><supuesto tipo=\"booleano\">true</supuesto><updated_by nil=\"true\" /><updated_at>2026-11-23T10:00:00+00:00</updated_at></supuesto></efectividad></efectividad_tipo>\n"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
