{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - regiones",
    "version": "0.1.0",
    "description": "Servicio de regiones del sistema de respuesta a epidemias: el estado y sus municipios, la jerarquía, las jurisdicciones sanitarias y la búsqueda territorial (D56). Público, de solo lectura y no usa Redis. Los ejemplos están en docs/contratos/regiones/ejemplos (listas recortadas)."
  },
  "servers": [
    {
      "url": "http://localhost:5213"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/regions": {
      "get": {
        "summary": "Listar regiones",
        "operationId": "listar_regiones",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "description": "Busca por nombre o clave del municipio: los que contienen el texto, sin distinguir mayúsculas. Vacío o ausente, regresa los 51.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "order",
            "schema": {
              "type": "string",
              "enum": [
                "nombre",
                "poblacion",
                "poblacion_60"
              ]
            }
          },
          {
            "in": "query",
            "name": "direction",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "municipios": [
                    {
                      "id": 3,
                      "code": "19039",
                      "nombre": "Monterrey",
                      "poblacion": 1142994,
                      "poblacion_60": 189513,
                      "fuente_poblacion": {
                        "tipo": "censal",
                        "fuente": "INEGI, Censo 2020"
                      },
                      "fuente_poblacion_60": {
                        "tipo": "derivado",
                        "fuente": "Grupos 60-79 y 80+ del Censo 2020"
                      }
                    },
                    {
                      "id": 5,
                      "code": "19006",
                      "nombre": "Apodaca",
                      "poblacion": 656464,
                      "poblacion_60": 45288,
                      "fuente_poblacion": {
                        "tipo": "censal",
                        "fuente": "INEGI, Censo 2020"
                      },
                      "fuente_poblacion_60": {
                        "tipo": "derivado",
                        "fuente": "Grupos 60-79 y 80+ del Censo 2020"
                      }
                    }
                  ],
                  "total": 51,
                  "busqueda": "",
                  "orden": "poblacion",
                  "direccion": "desc"
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "catalogo_regiones"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<catalogo_regiones><municipios><municipio><id tipo=\"numero\">3</id><code>19039</code><nombre>Monterrey</nombre><poblacion tipo=\"numero\">1142994</poblacion><poblacion_60 tipo=\"numero\">189513</poblacion_60><fuente_poblacion><tipo>censal</tipo><fuente>INEGI, Censo 2020</fuente></fuente_poblacion><fuente_poblacion_60><tipo>derivado</tipo><fuente>Grupos 60-79 y 80+ del Censo 2020</fuente></fuente_poblacion_60></municipio><municipio><id tipo=\"numero\">5</id><code>19006</code><nombre>Apodaca</nombre><poblacion tipo=\"numero\">656464</poblacion><poblacion_60 tipo=\"numero\">45288</poblacion_60><fuente_poblacion><tipo>censal</tipo><fuente>INEGI, Censo 2020</fuente></fuente_poblacion><fuente_poblacion_60><tipo>derivado</tipo><fuente>Grupos 60-79 y 80+ del Censo 2020</fuente></fuente_poblacion_60></municipio></municipios><total tipo=\"numero\">51</total><busqueda /><orden>poblacion</orden><direccion>desc</direccion></catalogo_regiones>\n"
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          },
          "429": {
            "description": "Demasiadas peticiones (LIMITE_EXCEDIDO). La cabecera Retry-After trae los segundos de espera.",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/regions/state": {
      "get": {
        "summary": "Consultar el estado",
        "operationId": "consultar_estado",
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": 1,
                  "code": "19",
                  "nombre": "Nuevo Leon",
                  "poblacion": 5784442,
                  "poblacion_60": 654050,
                  "fuente_poblacion": {
                    "tipo": "agregado"
                  },
                  "fuente_poblacion_60": {
                    "tipo": "derivado",
                    "fuente": "Grupos 60-79 y 80+ del Censo 2020"
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "estado"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<estado><id tipo=\"numero\">1</id><code>19</code><nombre>Nuevo Leon</nombre><poblacion tipo=\"numero\">5784442</poblacion><poblacion_60 tipo=\"numero\">654050</poblacion_60><fuente_poblacion><tipo>agregado</tipo></fuente_poblacion><fuente_poblacion_60><tipo>derivado</tipo><fuente>Grupos 60-79 y 80+ del Censo 2020</fuente></fuente_poblacion_60></estado>\n"
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "404": {
            "description": "No se encontró el estado. (NO_ENCONTRADO)"
          },
          "503": {
            "description": "Dependencia no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          },
          "429": {
            "description": "Demasiadas peticiones (LIMITE_EXCEDIDO). La cabecera Retry-After trae los segundos de espera.",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "description": "Nuevo León como fila única, para el encabezado de la pantalla de regiones: su población es el agregado de sus municipios y nunca se edita aparte (fuente_poblacion tipo agregado). fuente_poblacion_60 es derivado de los grupos de edad del Censo 2020 o, si alguien corrigió los de 60-79 u 80+, manual con motivo, fecha y por. Pública, como el catálogo."
      }
    },
    "/api/v1/regions/{region_id}": {
      "get": {
        "summary": "Consultar municipio",
        "operationId": "consultar_municipio",
        "parameters": [
