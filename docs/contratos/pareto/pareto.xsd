<?xml version="1.0" encoding="UTF-8"?>
<!-- La respuesta del servicio pareto (puerto 5245): GET /api/v1/pareto?runs=...&metric=...,
     raíz <pareto>. Es la salida de procesamiento.analitica.pareto.comparar(): una fila por
     corrida con su costo, su impacto y si otra la domina, y la frontera con los ids de las
     no dominadas, de la más barata a la más cara.
     D3: costo va en personas-día y es el eje de la frontera; costo_pesos va aparte, no entra
     a la frontera y es nulo si falta algún costo unitario. Lo mismo en cada renglón del
     desglose.
     impacto_evitado, costo_adicional y costo_por_unidad_evitada solo salen cuando hay
     escenario base; hoy el servicio no lo pide, así que base llega vacío y esos tres no
     vienen. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

  <xs:include schemaLocation="../comun/tipos.xsd"/>

  <!-- METRICAS_IMPACTO de procesamiento/analitica/pareto.py. -->
  <xs:simpleType name="metrica">
    <xs:restriction base="xs:string">
      <xs:enumeration value="fallecimientos"/>
      <xs:enumeration value="hospitalizaciones"/>
      <xs:enumeration value="casos_acumulados"/>
      <xs:enumeration value="pico_casos_activos"/>
      <xs:enumeration value="pico_hospitalizados"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- En qué se cuenta la cantidad de una intervención del desglose. -->
  <xs:simpleType name="unidadCantidad">
    <xs:restriction base="xs:string">
      <xs:enumeration value="habitante_dia"/>
      <xs:enumeration value="dosis"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- UNIDAD_COSTO: a qué se aplica el costo unitario en pesos. UNIDAD_FACTOR
       (personas_dia_por_dosis): el factor que lleva las dosis a personas-día. -->
  <xs:simpleType name="unidadCosto">
    <xs:restriction base="xs:string">
      <xs:enumeration value="por_habitante_dia"/>
      <xs:enumeration value="por_dosis"/>
      <xs:enumeration value="personas_dia_por_dosis"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="estadoTraza">
    <xs:restriction base="xs:string">
      <xs:enumeration value="con_fuente"/>
      <xs:enumeration value="supuesto"/>
      <xs:enumeration value="sin_fuente"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Ids">
    <xs:sequence>
      <xs:element name="corrida" type="Entero" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Un renglón del costo de una corrida: costo en personas-día y costo_pesos aparte. La
       vacunación se cuenta por dosis aplicadas y no tiene dia_fin, dias_activos ni intensidad. -->
  <xs:complexType name="CostoIntervencion">
    <xs:all>
      <xs:element name="tipo" type="xs:string"/>
      <xs:element name="dia_inicio" type="Entero"/>
      <xs:element name="dia_fin" type="EnteroONulo"/>
      <xs:element name="dias_activos" type="EnteroONulo"/>
      <xs:element name="intensidad" type="NumeroONulo"/>
      <xs:element name="cantidad" type="Numero"/>
      <xs:element name="unidad" type="unidadCantidad"/>
      <xs:element name="costo" type="Numero"/>
      <xs:element name="costo_pesos" type="NumeroONulo"/>
    </xs:all>
  </xs:complexType>

  <!-- Por qué una fila está dominada o en la frontera. dominada_por: cada alternativa que la
       domina, con sus valores y cuánto menos cuesta (diferencia_costo, personas-día) y cuánto
       menos impacto tiene (diferencia_impacto); criterios, en cuáles es estrictamente menor.
       compromisos: las que son menores en un solo criterio (mejor_en). empatada_con: ids con
       el mismo costo e impacto. No recomienda. -->
  <xs:complexType name="Dominante">
    <xs:all>
      <xs:element name="id" type="Entero"/>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="costo" type="Numero"/>
      <xs:element name="impacto" type="Numero"/>
      <xs:element name="diferencia_costo" type="Numero"/>
      <xs:element name="diferencia_impacto" type="Numero"/>
      <xs:element name="criterios">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="criterio" type="criterio" minOccurs="1" maxOccurs="2"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <xs:simpleType name="criterio">
    <xs:restriction base="xs:string">
      <xs:enumeration value="costo"/>
      <xs:enumeration value="impacto"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Compromiso">
    <xs:all>
      <xs:element name="id" type="Entero"/>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="mejor_en" type="criterio"/>
      <xs:element name="diferencia" type="Numero"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="Explicacion">
    <xs:all>
      <xs:element name="dominado" type="Booleano"/>
      <xs:element name="dominada_por">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="alternativa" type="Dominante" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="compromisos">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="compromiso" type="Compromiso" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="empatada_con" type="Ids"/>
      <xs:element name="texto" type="xs:string"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="Fila">
    <xs:all>
      <xs:element name="id" type="Entero"/>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="costo" type="Numero"/>
      <xs:element name="costo_pesos" type="NumeroONulo"/>
      <xs:element name="impacto" type="Numero"/>
      <xs:element name="desglose_costo">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="intervencion" type="CostoIntervencion" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="semilla" type="Entero"/>
      <xs:element name="engine_version" type="xs:string"/>
      <xs:element name="dias" type="Entero"/>
      <xs:element name="poblacion" type="Entero"/>
      <xs:element name="dominado" type="Booleano"/>
      <xs:element name="dominado_por" type="Ids"/>
      <xs:element name="explicacion" type="Explicacion"/>
      <xs:element name="impacto_evitado" type="NumeroONulo" minOccurs="0"/>
      <xs:element name="costo_adicional" type="NumeroONulo" minOccurs="0"/>
      <xs:element name="costo_por_unidad_evitada" type="NumeroONulo" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <!-- El costo unitario o el factor que se usó para un tipo de intervención, con su fuente. -->
  <xs:complexType name="CostoUnitario">
    <xs:all>
      <xs:element name="tipo" type="xs:string"/>
      <xs:element name="valor" type="Numero"/>
      <xs:element name="unidad" type="unidadCosto"/>
      <xs:element name="fuente" type="TextoONulo"/>
      <xs:element name="estado" type="estadoTraza"/>
    </xs:all>
  </xs:complexType>

  <xs:element name="pareto">
    <xs:complexType>
      <xs:all>
        <xs:element name="aviso" type="xs:string"/>
        <xs:element name="metrica" type="metrica"/>
        <xs:element name="base" type="EnteroONulo"/>
        <xs:element name="filas">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="fila" type="Fila" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="frontera" type="Ids"/>
        <xs:element name="trazabilidad_costos">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="costo" type="CostoUnitario" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="modelo_costo" type="xs:string"/>
        <xs:element name="avisos">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="aviso" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <!-- GET /api/v1/pareto/sensitivity: análisis exploratorio de un factor a la vez (D46).
       categoria es siempre exploratoria mientras no haya calibración (D39). -->
  <xs:complexType name="FilaSensibilidad">
    <xs:all>
      <xs:element name="valor" type="Numero"/>
      <xs:element name="es_base" type="Booleano"/>
      <xs:element name="media" type="Numero"/>
      <xs:element name="minimo" type="Numero"/>
      <xs:element name="maximo" type="Numero"/>
      <xs:element name="cambio_parametro_pct" type="Numero"/>
      <xs:element name="diferencia_vs_base" type="Numero"/>
      <xs:element name="cambio_metrica_pct" type="NumeroONulo"/>
    </xs:all>
  </xs:complexType>

  <xs:simpleType name="categoriaD39">
    <xs:restriction base="xs:string">
      <xs:enumeration value="exploratoria"/>
      <xs:enumeration value="prediccion"/>
      <xs:enumeration value="validada"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="sensibilidad">
    <xs:complexType>
      <xs:all>
        <xs:element name="aviso" type="xs:string"/>
        <xs:element name="version" type="Entero"/>
        <xs:element name="parametro" type="xs:string"/>
        <xs:element name="metrica" type="metrica"/>
        <xs:element name="valor_base" type="Numero"/>
        <xs:element name="semillas">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="semilla" type="Entero" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="engine_version" type="xs:string"/>
        <xs:element name="metodo" type="xs:string"/>
        <xs:element name="categoria" type="categoriaD39"/>
        <xs:element name="modelo_verificado" type="Booleano"/>
        <xs:element name="motivo" type="xs:string"/>
        <xs:element name="texto_categoria" type="xs:string"/>
        <xs:element name="filas">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="fila" type="FilaSensibilidad" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <!-- GET /api/v1/pareto/calibration: estado de calibración de cada versión de motor
       (procesamiento/estado_validacion.json). disponible es false: no hay ruta para calibrar
       mientras D24 siga reabierta. -->
  <xs:complexType name="EnfermedadRegion">
    <xs:all>
      <xs:element name="enfermedad" type="Entero"/>
      <xs:element name="region" type="Entero"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="ListaEnfermedadRegion">
    <xs:sequence>
      <xs:element name="enfermedad_region" type="EnfermedadRegion" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ModeloCalibracion">
    <xs:all>
      <xs:element name="engine_version" type="xs:string"/>
      <xs:element name="estado">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="sin_calibrar"/>
            <xs:enumeration value="calibrado"/>
            <xs:enumeration value="validado"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="verificado" type="Booleano"/>
      <xs:element name="calibrado" type="ListaEnfermedadRegion"/>
      <xs:element name="validado" type="ListaEnfermedadRegion"/>
      <xs:element name="categoria" type="categoriaD39"/>
      <xs:element name="motivo" type="xs:string"/>
      <xs:element name="texto" type="xs:string"/>
      <xs:element name="evidencia" type="xs:string"/>
    </xs:all>
  </xs:complexType>

  <xs:element name="calibracion">
    <xs:complexType>
      <xs:all>
        <xs:element name="aviso" type="xs:string"/>
        <xs:element name="disponible" type="Booleano"/>
        <xs:element name="ejecucion" type="xs:string"/>
        <xs:element name="modelos">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="modelo" type="ModeloCalibracion" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="nota" type="xs:string"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

</xs:schema>
