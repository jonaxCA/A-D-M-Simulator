{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - zonas",
    "version": "0.1.0",
    "description": "Detalle por zona y datos del mapa por municipio de Nuevo León."
  },
  "servers": [
    {
      "url": "http://localhost:5253"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/zones": {
      "get": {
        "summary": "Detalle por zona",
        "operationId": "detalle_zonas",
        "description": "Una fila por municipio con casos, incidencia, variación a 7 días, graves y semáforo. mayor_cambio se calcula sobre todas las zonas del ámbito, sin importar la página.",
        "parameters": [
          {
            "in": "query",
            "name": "disease_id",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Filtra por enfermedad"
          },
          {
            "in": "query",
            "name": "region_id",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Filtra por municipio de Nuevo León"
          },
          {
            "in": "query",
            "name": "days",
            "schema": {
              "type": "integer",
              "enum": [
                7,
                30,
                90
              ]
            },
            "description": "Periodo en días (por omisión 30)"
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "description": "Busca por nombre de municipio"
          },
          {
            "in": "query",
            "name": "order",
            "schema": {
              "type": "string",
              "enum": [
                "casos",
                "incidencia"
              ]
            },
            "description": "Orden de la tabla (por omisión incidencia)"
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "zonas": [
                    {
                      "id": 6,
                      "zona": "General Escobedo",
                      "casos": 549,
                      "incidencia": 114.1,
                      "variacion": 0.0,
                      "graves": 77,
                      "estado": "estable"
                    },
                    {
                      "id": 4,
                      "zona": "Guadalupe",
                      "casos": 683,
                      "incidencia": 106.2,
                      "variacion": 0.0,
                      "graves": 76,
                      "estado": "estable"
                    },
                    {
                      "id": 5,
                      "zona": "Apodaca",
                      "casos": 618,
                      "incidencia": 94.1,
                      "variacion": 0.0,
                      "graves": 79,
                      "estado": "estable"
                    }
                  ],
                  "total": 51,
                  "pagina": 1,
                  "paginas": 17,
                  "desde": 1,
                  "hasta": 3,
                  "filtros": {
                    "disease_id": null,
                    "region_id": null,
                    "days": 90,
                    "q": null,
                    "order": "incidencia"
                  },
                  "mayor_cambio": {
                    "estado": "sin_aumento",
                    "zona": null
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object"
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<zonas_detalle><zonas><zona><id tipo=\"numero\">6</id><zona>General Escobedo</zona><casos tipo=\"numero\">549</casos><incidencia tipo=\"numero\">114.1</incidencia><variacion tipo=\"numero\">0.0</variacion><graves tipo=\"numero\">77</graves><estado>estable</estado></zona><zona><id tipo=\"numero\">4</id><zona>Guadalupe</zona><casos tipo=\"numero\">683</casos><incidencia tipo=\"numero\">106.2</incidencia><variacion tipo=\"numero\">0.0</variacion><graves tipo=\"numero\">76</graves><estado>estable</estado></zona><zona><id tipo=\"numero\">5</id><zona>Apodaca</zona><casos tipo=\"numero\">618</casos><incidencia tipo=\"numero\">94.1</incidencia><variacion tipo=\"numero\">0.0</variacion><graves tipo=\"numero\">79</graves><estado>estable</estado></zona></zonas><total tipo=\"numero\">51</total><pagina tipo=\"numero\">1</pagina><paginas tipo=\"numero\">17</paginas><desde tipo=\"numero\">1</desde><hasta tipo=\"numero\">3</hasta><filtros><disease_id nil=\"true\" /><region_id nil=\"true\" /><days tipo=\"numero\">90</days><q nil=\"true\" /><order>incidencia</order></filtros><mayor_cambio><estado>sin_aumento</estado><zona nil=\"true\" /></mayor_cambio></zonas_detalle>\n"
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible"
          }
        }
      }
    },
