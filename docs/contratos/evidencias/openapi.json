    "/api/v1/reports": {
      "post": {
        "summary": "Subir el reporte de una comparación",
        "operationId": "subir_reporte",
        "description": "El PDF va tal cual en el cuerpo (no como formulario) y se valida por su contenido, su tamaño (hasta 20 MB) y, si trae X-Content-SHA256, su huella (RNF-C09, RNF-D27). Va al bucket y su registro, con CREATE en la bitácora, a comparison_reports (RF-F17). Lo usan el escritorio y la web (D35). El mismo PDF con las mismas corridas responde 200 con el que ya estaba. ANALISTA y ADMINISTRADOR (reports.upload).",
        "parameters": [
          {
            "in": "query",
            "name": "runs",
            "required": true,
            "schema": {
              "type": "string",
              "example": "12,15,20"
            },
            "description": "Ids de las corridas que compara el reporte, separados por comas (1 a 100)."
          },
          {
            "in": "query",
            "name": "title",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Título del reporte."
          },
          {
