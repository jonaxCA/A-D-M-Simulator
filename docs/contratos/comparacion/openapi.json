{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - comparacion",
    "version": "0.1.0",
    "description": "Compara corridas completadas lado a lado: indicadores y serie diaria de cada una. Muestra opciones; no recomienda un escenario."
  },
  "servers": [
    {
      "url": "http://localhost:5244"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/comparisons": {
      "get": {
        "summary": "Comparar corridas",
        "operationId": "comparar_corridas",
        "description": "Indicadores (fallecimientos, pico de casos activos, día del pico y tasa de ataque) y la serie diaria de cada corrida, en el orden pedido y sin repetidas. Las curvas superpuestas se arman con `serie`. Incluye el aviso de que los resultados no son una predicción. ANALISTA, EPIDEMIOLOGO y ADMINISTRADOR, como la pantalla Comparación del monolito.",
        "parameters": [
          {
            "in": "query",
            "name": "runs",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+(,[0-9]+)+$"
            },
            "example": "12,15",
            "description": "Ids de 2 a 50 corridas completadas, separados por comas"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
