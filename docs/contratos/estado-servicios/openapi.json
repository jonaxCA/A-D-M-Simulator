    "/api/v1/services/{nombre}/history": {
      "get": {
        "summary": "Historial de salud de un servicio",
        "operationId": "historial_servicio",
        "description": "Sus últimos sondeos, del más reciente al más viejo (hasta 30). Por servicio: `estado` (`ok`, `degradado` o `caido`), `causas` (`postgresql`, `redis` o `proceso`), `detalle` cuando está caído (`sin_conexion`, `tiempo_agotado` o `respuesta_invalida`), `version`, `latencia_ms` y `revisado` (ISO 8601, UTC).",
        "parameters": [
          {
            "in": "path",
            "name": "nombre",
