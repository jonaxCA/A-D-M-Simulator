                      "en_cola_por_prioridad": {
                        "alta": 1,
                        "normal": 2,
                        "baja": 0
                      },
                      "vivos": 1,
                      "ocupados": 1,
                      "libres": 0,
                      "simuladores": [
                        {
                          "nombre": "8d4b7a6c2e10",
                          "corrida_actual": 41,
                          "procesadas": 7,
                          "visto": "2026-11-21T18:30:04+00:00"
