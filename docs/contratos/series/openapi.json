    "/api/v1/series/cases/totals": {
      "get": {
        "summary": "Totales del periodo",
        "operationId": "totales_periodo",
        "description": "Casos e incidencia del periodo contra el periodo previo de igual largo.",
        "parameters": [
          {
            "in": "query",
            "name": "disease_id",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Filtra por enfermedad"
          },
          {
            "in": "query",
            "name": "region_id",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Filtra por municipio de Nuevo León"
          },
          {
            "in": "query",
            "name": "days",
            "schema": {
              "type": "integer",
              "enum": [
                7,
                30,
                90
              ]
            },
            "description": "Periodo en días (por omisión 30)"
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "filtros": {
                    "disease_id": null,
                    "region_id": null,
                    "days": 90
                  },
                  "totales": {
                    "casos": 3824,
                    "casos_previo": 0,
                    "casos_pct": 100.0,
                    "incidencia": 66.1,
                    "incidencia_previa": 0.0
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "totales"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real (listas recortadas)",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<totales><filtros><disease_id nil=\"true\" /><region_id nil=\"true\" /><days tipo=\"numero\">90</days></filtros><totales><casos tipo=\"numero\">3824</casos><casos_previo tipo=\"numero\">0</casos_previo><casos_pct tipo=\"numero\">100.0</casos_pct><incidencia tipo=\"numero\">66.1</incidencia><incidencia_previa tipo=\"numero\">0.0</incidencia_previa></totales></totales>\n"
                  }
                }
              }
            }
