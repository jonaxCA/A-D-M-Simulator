{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - series",
    "version": "0.1.0",
    "description": "Curva epidémica y series por edad, sexo y totales, con los filtros de Monitoreo."
  },
  "servers": [
    {
      "url": "http://localhost:5252"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/series/cases": {
      "get": {
        "summary": "Curva epidémica",
        "operationId": "curva_epidemica",
        "description": "Casos por día e incidencia acumulada por 100k.",
        "parameters": [
          {
            "in": "query",
            "name": "disease_id",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Filtra por enfermedad"
          },
          {
            "in": "query",
            "name": "region_id",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Filtra por municipio de Nuevo León"
          },
          {
            "in": "query",
            "name": "days",
            "schema": {
              "type": "integer",
              "enum": [
                7,
                30,
                90
              ]
            },
            "description": "Periodo en días (por omisión 30)"
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "filtros": {
                    "disease_id": null,
                    "region_id": null,
                    "days": 90
                  },
                  "puntos": [
                    {
                      "fecha": "2026-07-20",
                      "casos": 83,
                      "incidencia_acum": 1.43
                    },
                    {
                      "fecha": "2026-07-21",
                      "casos": 88,
                      "incidencia_acum": 2.96
                    },
                    {
                      "fecha": "2026-07-22",
                      "casos": 77,
                      "incidencia_acum": 4.29
                    }
                  ]
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "curva_epidemica"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real (listas recortadas)",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<curva_epidemica><filtros><disease_id nil=\"true\" /><region_id nil=\"true\" /><days tipo=\"numero\">90</days></filtros><puntos><punto><fecha>2026-07-20</fecha><casos tipo=\"numero\">83</casos><incidencia_acum tipo=\"numero\">1.43</incidencia_acum></punto><punto><fecha>2026-07-21</fecha><casos tipo=\"numero\">88</casos><incidencia_acum tipo=\"numero\">2.96</incidencia_acum></punto><punto><fecha>2026-07-22</fecha><casos tipo=\"numero\">77</casos><incidencia_acum tipo=\"numero\">4.29</incidencia_acum></punto></puntos></curva_epidemica>\n"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible"
          }
        }
      }
    },
    "/api/v1/series/cases/by-age": {
      "get": {
