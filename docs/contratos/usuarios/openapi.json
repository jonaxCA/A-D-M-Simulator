{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - usuarios",
    "version": "0.1.0",
    "description": "Administra cuentas (solo ADMINISTRADOR), con su institución y región opcionales (D42); cada cuenta consulta su perfil en /users/me. Administra también el catálogo de instituciones. Escribe users e institutions; el rol se asigna en el servicio roles. Desactivar, eliminar o cambiar la contraseña cierra las sesiones de la cuenta."
  },
  "servers": [
    {
      "url": "http://localhost:5203"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/users": {
      "get": {
        "summary": "Listar cuentas",
        "operationId": "listar_usuarios",
        "description": "Filtros opcionales: q (nombre, correo o usuario), role_id y status (activo, pendiente, inactivo).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "description": "Busca por nombre completo, correo o nombre de usuario: los que contienen el texto, sin distinguir mayúsculas. Vacío o ausente, regresa todos.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "role_id",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "activo",
                "pendiente",
                "inactivo"
              ]
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "total": 1,
                  "usuarios": [
                    {
                      "id": 9,
                      "nombre": "Ana Lista",
                      "correo": "ana@ejemplo.mx",
                      "roles": "Analista",
                      "estado": "activo",
                      "ultimo_acceso": "2026-10-12T09:30:00-06:00",
                      "institucion": null,
                      "region": null
                    }
                  ]
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "catalogo_usuarios"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<catalogo_usuarios><total tipo=\"numero\">1</total><usuarios><item><id tipo=\"numero\">9</id><nombre>Ana Lista</nombre><correo>ana@ejemplo.mx</correo><roles>Analista</roles><estado>activo</estado><ultimo_acceso>2026-10-12T09:30:00-06:00</ultimo_acceso><institucion nil=\"true\" /><region nil=\"true\" /></item></usuarios></catalogo_usuarios>\n"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente (solo ADMINISTRADOR)"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Redis no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          },
          "429": {
            "description": "Demasiadas peticiones (LIMITE_EXCEDIDO). La cabecera Retry-After trae los segundos de espera.",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear cuenta",
        "operationId": "crear_usuario",
        "description": "Alta sin rol: el rol se asigna con PUT /api/v1/roles/assignments/{user_id}. Contraseña de al menos 8 caracteres. Audita CREATE. institution_id y region_id son opcionales (D42); si no existen, 422.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Creado (responde 201)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": 10,
                  "username": "beto",
                  "email": "beto@ejemplo.mx",
                  "full_name": "Beto Ejemplo",
                  "is_active": true,
                  "institution_id": 1,
                  "region_id": 19
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "usuario"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<usuario><id tipo=\"numero\">10</id><username>beto</username><email>beto@ejemplo.mx</email><full_name>Beto Ejemplo</full_name><is_active tipo=\"booleano\">true</is_active><institution_id tipo=\"numero\">1</institution_id><region_id tipo=\"numero\">19</region_id></usuario>"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente (solo ADMINISTRADOR)"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Redis no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          },
          "429": {
            "description": "Demasiadas peticiones (LIMITE_EXCEDIDO). La cabecera Retry-After trae los segundos de espera.",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "username": "beto",
                "email": "beto@ejemplo.mx",
                "full_name": "Beto Ejemplo",
                "password": "CONTRASENA_DE_EJEMPLO",
                "is_active": true,
                "institution_id": 1,
                "region_id": 19
              }
            },
            "application/xml": {
              "schema": {
                "type": "object",
                "xml": {
                  "name": "usuario"
                }
              },
              "examples": {
                "peticion": {
                  "summary": "Petición",
                  "value": "<?xml version='1.0' encoding='utf-8'?>\n<usuario><username>beto</username><email>beto@ejemplo.mx</email><full_name>Beto Ejemplo</full_name><password>CONTRASENA_DE_EJEMPLO</password><is_active tipo=\"booleano\">true</is_active><institution_id tipo=\"numero\">1</institution_id><region_id tipo=\"numero\">19</region_id></usuario>"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/summary": {
      "get": {
        "summary": "Resumen de cuentas",
        "operationId": "resumen_usuarios",
        "description": "Las tarjetas de la pantalla de usuarios: total y cuántas están activas (ya entraron alguna vez), pendientes (activas que nunca han entrado) e inactivas (baja lógica). Los mismos estados que el filtro status de listar_usuarios.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "total": 14,
                  "activos": 11,
                  "pendientes": 2,
                  "inactivos": 1
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "resumen_usuarios"
                  }
                },
                "examples": {
                  "respuesta": {
                    "summary": "Respuesta real",
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<resumen_usuarios><total tipo=\"numero\">14</total><activos tipo=\"numero\">11</activos><pendientes tipo=\"numero\">2</pendientes><inactivos tipo=\"numero\">1</inactivos></resumen_usuarios>"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Rol sin permiso (PERMISO_INSUFICIENTE): solo ADMINISTRADOR. Queda en la bitácora como PERMISSION_DENIED."
          },
          "503": {
            "description": "Redis no disponible. También se devuelve si PostgreSQL no responde (detail «La base de datos no está disponible.»)."
          },
          "429": {
            "description": "Demasiadas peticiones (LIMITE_EXCEDIDO). La cabecera Retry-After trae los segundos de espera.",
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar antes de reintentar",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
