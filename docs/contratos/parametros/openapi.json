{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - parametros",
    "version": "0.1.0",
    "description": "Servicio de parametros del sistema de respuesta a epidemias. Los ejemplos están en docs/contratos/parametros/ejemplos (listas recortadas). Pendiente: con letalidad_por_edad, el XML de la consulta usa claves como 0-19 como etiqueta y queda mal formado (falla en epidemia_comun.formatos.a_xml)."
  },
  "servers": [
    {
      "url": "http://localhost:5212"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/diseases/{disease_id}/parameters": {
      "get": {
        "summary": "Consultar parámetros epidemiológicos",
        "operationId": "consultar_par_metros_epidemiol_gicos",
        "parameters": [
          {
            "in": "path",
            "name": "disease_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "disease_id": 2,
                  "parametros": {
                    "r0": {
                      "valor": 1.3,
                      "fuente": "Biggerstaff et al. 2014",
                      "supuesto": false
                    },
                    "incubacion_dias": {
                      "valor": 1.4,
                      "fuente": "Lessler et al. 2009",
                      "supuesto": false
                    }
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "parametros"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<parametros><disease_id tipo=\"numero\">2</disease_id><parametros><r0><valor tipo=\"numero\">1.3</valor><fuente>Biggerstaff et al. 2014</fuente><supuesto tipo=\"booleano\">false</supuesto></r0><incubacion_dias><valor tipo=\"numero\">1.4</valor><fuente>Lessler et al. 2009</fuente><supuesto tipo=\"booleano\">false</supuesto></incubacion_dias></parametros></parametros>\n"
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible"
          }
        }
      },
      "put": {
        "summary": "Actualizar parámetros epidemiológicos",
        "operationId": "actualizar_par_metros_epidemiol_gicos",
        "description": "Cada parámetro lleva fuente o supuesto=true; si no, 422. Las tasas van como fracción (0 a 1). Los parámetros que no se envían se conservan.",
        "parameters": [
          {
            "in": "path",
            "name": "disease_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "disease_id": 2,
                  "parametros": {
                    "r0": {
                      "valor": 1.3,
                      "fuente": "Biggerstaff et al. 2014",
                      "supuesto": false
                    },
                    "incubacion_dias": {
                      "valor": 1.4,
                      "fuente": "Lessler et al. 2009",
                      "supuesto": false
                    },
                    "infeccioso_dias": {
                      "valor": 4.8,
                      "fuente": null,
                      "supuesto": true
                    }
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "parametros"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<parametros><disease_id tipo=\"numero\">2</disease_id><parametros><r0><valor tipo=\"numero\">1.3</valor><fuente>Biggerstaff et al. 2014</fuente><supuesto tipo=\"booleano\">false</supuesto></r0><incubacion_dias><valor tipo=\"numero\">1.4</valor><fuente>Lessler et al. 2009</fuente><supuesto tipo=\"booleano\">false</supuesto></incubacion_dias><infeccioso_dias><valor tipo=\"numero\">4.8</valor><fuente nil=\"true\" /><supuesto tipo=\"booleano\">true</supuesto></infeccioso_dias></parametros></parametros>\n"
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "parametros"
                ],
                "additionalProperties": false,
                "properties": {
                  "parametros": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": [
                        "valor"
                      ],
                      "properties": {
                        "valor": {
                          "type": "number"
                        },
                        "fuente": {
                          "type": "string",
                          "nullable": true
                        },
                        "supuesto": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "parametros": {
                  "infeccioso_dias": {
                    "valor": 4.8,
                    "supuesto": true
                  }
                }
              }
            },
            "application/xml": {
              "schema": {
                "type": "object",
                "required": [
                  "parametros"
                ],
                "additionalProperties": false,
                "properties": {
                  "parametros": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": [
                        "valor"
                      ],
                      "properties": {
                        "valor": {
                          "type": "number"
                        },
                        "fuente": {
                          "type": "string",
                          "nullable": true
                        },
                        "supuesto": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/diseases/{disease_id}/parameters/status": {
      "get": {
        "summary": "Estado de parámetros epidemiológicos",
        "operationId": "estado_de_par_metros_epidemiol_gicos",
        "parameters": [
          {
            "in": "path",
            "name": "disease_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "XML por defecto; JSON con ?format=json o Accept: application/json",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "detalle": [
                    {
                      "clave": "r0",
                      "etiqueta": "R₀ — número reproductivo básico",
                      "unidad": "contagios por caso",
                      "min": 0.01,
                      "max": 20.0,
                      "paso": "0.01",
                      "ayuda": "Contagios que genera un caso en una población sin inmunidad.",
                      "valor": 1.3,
                      "valor_form": "1.3",
                      "fuente": "Biggerstaff et al. 2014",
                      "supuesto": false,
                      "estado": "con_fuente"
                    },
                    {
                      "clave": "infeccioso_dias",
                      "etiqueta": "Período infeccioso",
                      "unidad": "días",
                      "min": 0.1,
                      "max": 60.0,
                      "paso": "0.1",
                      "ayuda": "Cuánto tiempo puede contagiar una persona.",
                      "valor": null,
                      "valor_form": "",
                      "fuente": "",
                      "supuesto": false,
                      "estado": "falta"
                    }
                  ],
                  "informativos": [],
                  "faltan": [
                    "infeccioso_dias",
                    "dias_hospitalizacion",
                    "tasa_hospitalizacion",
                    "letalidad"
                  ],
                  "supuestos": [],
                  "sin_fuente": [],
                  "simulable": false
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "estado_parametros"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<estado_parametros><detalle><item><clave>r0</clave><etiqueta>R₀ — número reproductivo básico</etiqueta><unidad>contagios por caso</unidad><min tipo=\"numero\">0.01</min><max tipo=\"numero\">20.0</max><paso>0.01</paso><ayuda>Contagios que genera un caso en una población sin inmunidad.</ayuda><valor tipo=\"numero\">1.3</valor><valor_form>1.3</valor_form><fuente>Biggerstaff et al. 2014</fuente><supuesto tipo=\"booleano\">false</supuesto><estado>con_fuente</estado></item><item><clave>infeccioso_dias</clave><etiqueta>Período infeccioso</etiqueta><unidad>días</unidad><min tipo=\"numero\">0.1</min><max tipo=\"numero\">60.0</max><paso>0.1</paso><ayuda>Cuánto tiempo puede contagiar una persona.</ayuda><valor nil=\"true\" /><valor_form /><fuente /><supuesto tipo=\"booleano\">false</supuesto><estado>falta</estado></item></detalle><informativos /><faltan><item>infeccioso_dias</item><item>dias_hospitalizacion</item><item>tasa_hospitalizacion</item><item>letalidad</item></faltan><supuestos /><sin_fuente /><simulable tipo=\"booleano\">false</simulable></estado_parametros>\n"
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Falta token o token inválido"
          },
          "403": {
            "description": "Permiso insuficiente"
          },
          "404": {
            "description": "Registro inexistente"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "503": {
            "description": "Dependencia no disponible"
          }
        }
      }
    }
  }
}
