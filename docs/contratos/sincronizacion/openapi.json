{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - sincronizacion",
    "version": "0.1.0",
    "description": "Recibe lotes de casos capturados sin conexión y los manda uno por uno al servicio casos (JSON, con el token de quien sincroniza). Reenviar el mismo lote no duplica: el resultado se guarda en Redis (sync:lote:<batch_id>, 7 días) y local_uuid evita duplicados en casos. Roles: CAPTURISTA y ADMINISTRADOR. XML por defecto y JSON con ?format=json o Accept: application/json; cuerpos en los dos formatos (en XML, los casos van como <cases><item>...</item></cases>). XSD en lote.xsd (raíz lote en la petición y resultado_lote en la respuesta)."
  },
  "servers": [
    {
      "url": "http://localhost:5222"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token del servicio auth, con sesión activa en Redis."
      }
    },
    "schemas": {
      "LoteEntrada": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch_id",
          "cases"
        ],
        "properties": {
          "batch_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID que genera el cliente. lote_id se acepta como alias."
          },
          "device_id": {
            "type": "integer",
            "description": "Se aplica a los casos que no traigan el suyo."
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "description": "Mismos campos que CasoEntrada del servicio casos; local_uuid es obligatorio.",
              "properties": {
                "local_uuid": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Llave de deduplicación; la genera el dispositivo."
                },
                "device_id": {
                  "type": "integer",
                  "nullable": true,
                  "description": "devices.id del dispositivo de captura."
                },
                "disease_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "region_id": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Municipio de Nuevo León del catálogo."
                },
                "age": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 120,
                  "nullable": true
                },
                "sex": {
                  "type": "string",
                  "enum": [
                    "M",
                    "F",
                    "O"
                  ],
                  "nullable": true
                },
                "onset_date": {
                  "type": "string",
                  "format": "date",
                  "nullable": true,
                  "description": "No puede ser posterior a report_date."
                },
                "report_date": {
                  "type": "string",
                  "format": "date",
                  "description": "No puede estar en el futuro."
                },
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90,
                  "nullable": true
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180,
                  "nullable": true,
                  "description": "Latitud y longitud van juntas o ninguna."
                },
                "test_result": {
                  "type": "string",
                  "enum": [
                    "positivo",
                    "negativo",
                    "pendiente",
                    "sin_prueba"
                  ],
                  "nullable": true
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "asintomatico",
                    "leve",
                    "grave",
                    "fallecido"
                  ],
                  "nullable": true
                }
              },
              "required": [
                "local_uuid"
              ]
            }
          }
        }
      },
      "ResultadoCaso": {
        "type": "object",
        "properties": {
          "indice": {
            "type": "integer"
          },
          "local_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "resultado": {
            "type": "string",
            "enum": [
              "creado",
              "duplicado",
              "rechazado"
            ]
          },
          "case_id": {
            "type": "integer",
            "nullable": true
          },
          "errores": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Lote": {
        "type": "object",
        "properties": {
          "batch_id": {
            "type": "string",
            "format": "uuid"
          },
          "device_id": {
            "type": "integer",
            "nullable": true
          },
          "recibido_en": {
            "type": "string",
            "format": "date-time"
          },
          "total": {
            "type": "integer"
          },
          "creados": {
            "type": "integer"
          },
          "duplicados": {
            "type": "integer"
          },
          "rechazados": {
            "type": "integer"
          },
          "resultados": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResultadoCaso"
            }
          },
          "repetido": {
            "type": "boolean",
            "description": "true si el resultado salió de lo guardado en Redis."
          }
        }
      },
      "Problema": {
        "type": "object",
        "description": "Error RFC 7807 de la biblioteca común.",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "codigo": {
            "type": "string",
            "description": "Código de la tabla de errores común.",
            "example": "DATOS_INVALIDOS"
          },
          "instance": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "codigo",
          "instance"
        ]
      }
    }
  },
  "paths": {
    "/api/v1/sync/cases": {
      "post": {
        "summary": "Enviar un lote de casos",
        "operationId": "enviar_lote",
        "tags": [
          "sincronizacion"
        ],
        "description": "Llama a POST /api/v1/cases de casos, un caso a la vez y sin reintentos. creado = casos respondió 201; duplicado = 200 (ya existía ese local_uuid); rechazado = 400/409/415/422 de casos, con sus errores. Si casos no responde, o responde 5xx, todo el lote es 503 y no se guarda (se puede reenviar: local_uuid evita duplicar lo ya creado, que saldrá como duplicado). Un candado por lote (409 si otra petición lo está procesando). Deja un SYNC en audit_log con los conteos. Roles: CAPTURISTA, ADMINISTRADOR. Máximo 100 casos.",
        "parameters": [
          {
            "in": "query",
            "name": "format",
            "description": "Formato de la respuesta. XML por defecto; JSON con ?format=json o con el encabezado Accept: application/json. Si chocan manda ?format. Un valor desconocido es 400.",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          },
          {
            "in": "header",
            "name": "X-Correlation-ID",
            "required": false,
            "description": "Identificador para rastrear la petición entre servicios. Si falta, el servicio genera uno y lo devuelve en el mismo encabezado.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Lote capturado sin conexión.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoteEntrada"
              },
              "example": {
                "batch_id": "0b6f5a53-1d1f-4f52-8a0a-5d0a4a0e9c11",
                "device_id": 3,
                "cases": [
                  {
                    "local_uuid": "6f1f4f0e-3c6b-4f4c-9d9e-1a2b3c4d5e6f",
                    "disease_id": 1,
                    "region_id": 10,
                    "report_date": "2026-10-01",
                    "onset_date": "2026-09-28",
                    "age": 34,
                    "sex": "F",
                    "latitude": 25.6866,
                    "longitude": -100.3161,
                    "test_result": "positivo",
                    "severity": "leve"
                  },
                  {
                    "local_uuid": "8a3d2c10-77b5-4c1e-9f0a-2b6d9c4e1a77",
                    "disease_id": 1,
                    "region_id": 999,
                    "report_date": "2026-10-02"
                  }
                ]
              }
            },
            "application/xml": {
              "schema": {
                "type": "object",
                "xml": {
                  "name": "lote"
                }
              },
              "example": "<?xml version='1.0' encoding='utf-8'?>\n<lote><batch_id>0b6f5a53-1d1f-4f52-8a0a-5d0a4a0e9c11</batch_id><device_id tipo=\"numero\">3</device_id><cases><item><local_uuid>6f1f4f0e-3c6b-4f4c-9d9e-1a2b3c4d5e6f</local_uuid><disease_id tipo=\"numero\">1</disease_id><region_id tipo=\"numero\">10</region_id><report_date>2026-10-01</report_date><onset_date>2026-09-28</onset_date><age tipo=\"numero\">34</age><sex>F</sex><latitude tipo=\"numero\">25.6866</latitude><longitude tipo=\"numero\">-100.3161</longitude><test_result>positivo</test_result><severity>leve</severity></item><item><local_uuid>8a3d2c10-77b5-4c1e-9f0a-2b6d9c4e1a77</local_uuid><disease_id tipo=\"numero\">1</disease_id><region_id tipo=\"numero\">999</region_id><report_date>2026-10-02</report_date></item></cases></lote>\n"
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lote procesado, o ya recibido antes (repetido=true; se regresa lo guardado sin volver a llamar a casos). Cada caso trae creado, duplicado o rechazado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lote"
                },
                "example": {
                  "batch_id": "0b6f5a53-1d1f-4f52-8a0a-5d0a4a0e9c11",
                  "device_id": 3,
                  "recibido_en": "2026-10-12T10:00:00+00:00",
                  "total": 2,
                  "creados": 1,
                  "duplicados": 0,
                  "rechazados": 1,
                  "resultados": [
                    {
                      "indice": 0,
                      "local_uuid": "6f1f4f0e-3c6b-4f4c-9d9e-1a2b3c4d5e6f",
                      "resultado": "creado",
                      "case_id": 41,
                      "errores": []
                    },
                    {
                      "indice": 1,
                      "local_uuid": "8a3d2c10-77b5-4c1e-9f0a-2b6d9c4e1a77",
                      "resultado": "rechazado",
                      "case_id": null,
                      "errores": [
                        "Ese municipio no está en el catálogo de Nuevo León."
                      ]
                    }
                  ],
                  "repetido": false
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "resultado_lote"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<resultado_lote><batch_id>0b6f5a53-1d1f-4f52-8a0a-5d0a4a0e9c11</batch_id><device_id tipo=\"numero\">3</device_id><recibido_en>2026-10-12T10:00:00+00:00</recibido_en><total tipo=\"numero\">2</total><creados tipo=\"numero\">1</creados><duplicados tipo=\"numero\">0</duplicados><rechazados tipo=\"numero\">1</rechazados><resultados><item><indice tipo=\"numero\">0</indice><local_uuid>6f1f4f0e-3c6b-4f4c-9d9e-1a2b3c4d5e6f</local_uuid><resultado>creado</resultado><case_id tipo=\"numero\">41</case_id><errores /></item><item><indice tipo=\"numero\">1</indice><local_uuid>8a3d2c10-77b5-4c1e-9f0a-2b6d9c4e1a77</local_uuid><resultado>rechazado</resultado><case_id nil=\"true\" /><errores><item>Ese municipio no está en el catálogo de Nuevo León.</item></errores></item></resultados><repetido tipo=\"booleano\">false</repetido></resultado_lote>\n"
              }
            }
          },
          "409": {
            "description": "Conflict. RFC 7807; en XML, application/problem+xml.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Conflict",
                  "status": 409,
                  "detail": "Ese lote ya se está procesando; intenta de nuevo.",
                  "codigo": "CONFLICTO",
                  "instance": "/api/v1/sync/cases"
                }
              },
              "application/problem+xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "problem"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<problem><type>about:blank</type><title>Conflict</title><status tipo=\"numero\">409</status><detail>Ese lote ya se está procesando; intenta de nuevo.</detail><codigo>CONFLICTO</codigo><instance>/api/v1/sync/cases</instance></problem>\n"
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity. RFC 7807; en XML, application/problem+xml.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Entity",
                  "status": 422,
                  "detail": "Cada caso necesita su local_uuid.",
                  "codigo": "DATOS_INVALIDOS",
                  "instance": "/api/v1/sync/cases"
                }
              },
              "application/problem+xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "problem"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<problem><type>about:blank</type><title>Unprocessable Entity</title><status tipo=\"numero\">422</status><detail>Cada caso necesita su local_uuid.</detail><codigo>DATOS_INVALIDOS</codigo><instance>/api/v1/sync/cases</instance></problem>\n"
              }
            }
          },
          "401": {
            "description": "Unauthorized. RFC 7807; en XML, application/problem+xml.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unauthorized",
                  "status": 401,
                  "detail": "Falta Authorization: Bearer.",
                  "codigo": "TOKEN_AUSENTE",
                  "instance": "/api/v1/sync/cases"
                }
              },
              "application/problem+xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "problem"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<problem><type>about:blank</type><title>Unauthorized</title><status tipo=\"numero\">401</status><detail>Falta Authorization: Bearer.</detail><codigo>TOKEN_AUSENTE</codigo><instance>/api/v1/sync/cases</instance></problem>\n"
              }
            }
          },
          "403": {
            "description": "Forbidden. RFC 7807; en XML, application/problem+xml.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Forbidden",
                  "status": 403,
                  "detail": "No tienes permiso para esta operación.",
                  "codigo": "PERMISO_INSUFICIENTE",
                  "instance": "/api/v1/sync/cases"
                }
              },
              "application/problem+xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "problem"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<problem><type>about:blank</type><title>Forbidden</title><status tipo=\"numero\">403</status><detail>No tienes permiso para esta operación.</detail><codigo>PERMISO_INSUFICIENTE</codigo><instance>/api/v1/sync/cases</instance></problem>\n"
              }
            }
          },
          "503": {
            "description": "Service Unavailable. Redis o el servicio casos no responden; no se guarda nada y el lote se puede reenviar.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "Redis no está disponible.",
                  "codigo": "SERVICIO_NO_DISPONIBLE",
                  "instance": "/api/v1/sync/cases"
                }
              },
              "application/problem+xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "problem"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<problem><type>about:blank</type><title>Service Unavailable</title><status tipo=\"numero\">503</status><detail>Redis no está disponible.</detail><codigo>SERVICIO_NO_DISPONIBLE</codigo><instance>/api/v1/sync/cases</instance></problem>\n"
              }
            }
          },
          "400": {
            "description": "Cuerpo JSON/XML ilegible, o ?format desconocido (DATOS_INVALIDOS)."
          }
        }
      }
    },
    "/api/v1/sync/batches/{batch_id}": {
      "get": {
        "summary": "Consultar el resultado de un lote",
        "operationId": "consultar_lote",
        "tags": [
          "sincronizacion"
        ],
        "description": "Regresa lo guardado en Redis para el lote. 404 si no existe, venció (7 días) o es de otra persona (el ADMINISTRADOR ve todos). Roles: CAPTURISTA, ADMINISTRADOR.",
        "parameters": [
          {
            "in": "path",
            "name": "batch_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "format",
            "description": "Formato de la respuesta. XML por defecto; JSON con ?format=json o con el encabezado Accept: application/json. Si chocan manda ?format. Un valor desconocido es 400.",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "json"
              ]
            }
          },
          {
            "in": "header",
            "name": "X-Correlation-ID",
            "required": false,
            "description": "Identificador para rastrear la petición entre servicios. Si falta, el servicio genera uno y lo devuelve en el mismo encabezado.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado guardado del lote (repetido=true).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lote"
                },
                "example": {
                  "batch_id": "0b6f5a53-1d1f-4f52-8a0a-5d0a4a0e9c11",
                  "device_id": 3,
                  "recibido_en": "2026-10-12T10:00:00+00:00",
                  "total": 2,
                  "creados": 1,
                  "duplicados": 0,
                  "rechazados": 1,
                  "resultados": [
                    {
                      "indice": 0,
                      "local_uuid": "6f1f4f0e-3c6b-4f4c-9d9e-1a2b3c4d5e6f",
                      "resultado": "creado",
                      "case_id": 41,
                      "errores": []
                    },
                    {
                      "indice": 1,
                      "local_uuid": "8a3d2c10-77b5-4c1e-9f0a-2b6d9c4e1a77",
                      "resultado": "rechazado",
                      "case_id": null,
                      "errores": [
                        "Ese municipio no está en el catálogo de Nuevo León."
                      ]
                    }
                  ],
                  "repetido": true
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "resultado_lote"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<resultado_lote><batch_id>0b6f5a53-1d1f-4f52-8a0a-5d0a4a0e9c11</batch_id><device_id tipo=\"numero\">3</device_id><recibido_en>2026-10-12T10:00:00+00:00</recibido_en><total tipo=\"numero\">2</total><creados tipo=\"numero\">1</creados><duplicados tipo=\"numero\">0</duplicados><rechazados tipo=\"numero\">1</rechazados><resultados><item><indice tipo=\"numero\">0</indice><local_uuid>6f1f4f0e-3c6b-4f4c-9d9e-1a2b3c4d5e6f</local_uuid><resultado>creado</resultado><case_id tipo=\"numero\">41</case_id><errores /></item><item><indice tipo=\"numero\">1</indice><local_uuid>8a3d2c10-77b5-4c1e-9f0a-2b6d9c4e1a77</local_uuid><resultado>rechazado</resultado><case_id nil=\"true\" /><errores><item>Ese municipio no está en el catálogo de Nuevo León.</item></errores></item></resultados><repetido tipo=\"booleano\">true</repetido></resultado_lote>\n"
              }
            }
          },
          "404": {
            "description": "Not Found. RFC 7807; en XML, application/problem+xml.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Not Found",
                  "status": 404,
                  "detail": "No existe ese lote, o ya venció.",
                  "codigo": "NO_ENCONTRADO",
                  "instance": "/api/v1/sync/batches/0b6f5a53-1d1f-4f52-8a0a-5d0a4a0e9c11"
                }
              },
              "application/problem+xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "problem"
                  }
                },
                "example": "<?xml version='1.0' encoding='utf-8'?>\n<problem><type>about:blank</type><title>Not Found</title><status tipo=\"numero\">404</status><detail>No existe ese lote, o ya venció.</detail><codigo>NO_ENCONTRADO</codigo><instance>/api/v1/sync/batches/0b6f5a53-1d1f-4f52-8a0a-5d0a4a0e9c11</instance></problem>\n"
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity. RFC 7807; en XML, application/problem+xml.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Unprocessable Entity",
                  "status": 422,
                  "detail": "batch_id debe ser un UUID válido.",
                  "codigo": "DATOS_INVALIDOS",
                  "instance": "/api/v1/sync/batches/0b6f5a53-1d1f-4f52-8a0a-5d0a4a0e9c11"
                }
              },
              "application/problem+xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "problem"
