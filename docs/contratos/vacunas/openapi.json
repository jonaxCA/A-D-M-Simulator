{
  "openapi": "3.0.3",
  "info": {
    "title": "EPIDEMIA - vacunas",
    "version": "0.1.0",
    "description": "Lotes de vacuna (tabla vaccine_lots) que la app móvil lee por QR o código de barras, y las dosis que se les aplican. Nunca se aplican más dosis de las que trae un lote, aunque dos teléfonos apliquen a la vez, ni a un lote caducado (la fecha se cuenta en hora de Monterrey). Registran y aplican CAPTURISTA y ADMINISTRADOR; consultan los cuatro roles. XML por defecto y JSON con ?format=json o Accept: application/json; los cuerpos se aceptan en los dos formatos."
  },
  "servers": [
    {
      "url": "http://localhost:5225"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token del servicio auth, con sesión activa en Redis."
      }
    }
  },
  "paths": {
    "/api/v1/vaccine-lots": {
      "post": {
        "summary": "Registrar un lote escaneado",
        "operationId": "registrar_lote",
        "description": "201 si el lot_code es nuevo. Si ya estaba con los mismos datos (un reintento), 200 con el que había; con otros datos, 409: hay que consultarlo por su código. CAPTURISTA y ADMINISTRADOR.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "lot_code",
                  "disease_id",
                  "doses_total"
                ],
                "properties": {
                  "lot_code": {
                    "type": "string",
                    "pattern": "^[\\x21-\\x7e]{1,60}$",
                    "description": "El código leído del QR o del código de barras: de 1 a 60 caracteres visibles, sin espacios. Único."
                  },
                  "manufacturer": {
                    "type": "string",
                    "maxLength": 120,
                    "nullable": true
                  },
                  "disease_id": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Enfermedad que previene"
                  },
                  "region_id": {
                    "type": "integer",
                    "minimum": 1,
                    "nullable": true,
                    "description": "Municipio donde está asignado el lote"
                  },
                  "doses_total": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "expires_on": {
                    "type": "string",
                    "format": "date",
                    "nullable": true,
                    "description": "Caducidad. Un lote caducado se registra, pero no se le aplican dosis."
                  }
                }
              },
              "example": {
                "lot_code": "FL3239-2026",
                "manufacturer": "Sanofi Pasteur",
                "disease_id": 1,
                "region_id": 39,
                "doses_total": 500,
                "expires_on": "2027-03-31"
              }
            },
            "application/xml": {
              "schema": {
                "type": "object",
                "required": [
                  "lot_code",
                  "disease_id",
                  "doses_total"
                ],
                "properties": {
                  "lot_code": {
                    "type": "string",
                    "pattern": "^[\\x21-\\x7e]{1,60}$",
                    "description": "El código leído del QR o del código de barras: de 1 a 60 caracteres visibles, sin espacios. Único."
                  },
                  "manufacturer": {
                    "type": "string",
                    "maxLength": 120,
                    "nullable": true
                  },
                  "disease_id": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Enfermedad que previene"
                  },
                  "region_id": {
                    "type": "integer",
                    "minimum": 1,
                    "nullable": true,
                    "description": "Municipio donde está asignado el lote"
                  },
                  "doses_total": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "expires_on": {
                    "type": "string",
                    "format": "date",
                    "nullable": true,
                    "description": "Caducidad. Un lote caducado se registra, pero no se le aplican dosis."
                  }
                },
                "xml": {
                  "name": "solicitud"
                }
              },
              "examples": {
                "peticion": {
                  "value": "<?xml version='1.0' encoding='utf-8'?>\n<solicitud><lot_code>FL3239-2026</lot_code><manufacturer>Sanofi Pasteur</manufacturer><disease_id tipo=\"numero\">1</disease_id><region_id tipo=\"numero\">39</region_id><doses_total tipo=\"numero\">500</doses_total><expires_on>2027-03-31</expires_on></solicitud>\n"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": 5,
                  "lot_code": "FL3239-2026",
                  "manufacturer": "Sanofi Pasteur",
                  "disease_id": 1,
                  "disease_name": "Influenza A",
                  "region_id": 39,
                  "region_name": "Monterrey",
                  "doses_total": 500,
                  "doses_used": 0,
                  "doses_remaining": 500,
                  "expires_on": "2027-03-31",
                  "vencido": false,
                  "scanned_by": 4,
                  "scanned_at": "2026-11-01T18:10:00+00:00"
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "lote_vacuna"
                  }
                },
                "examples": {
                  "respuesta": {
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<lote_vacuna><id tipo=\"numero\">5</id><lot_code>FL3239-2026</lot_code><manufacturer>Sanofi Pasteur</manufacturer><disease_id tipo=\"numero\">1</disease_id><disease_name>Influenza A</disease_name><region_id tipo=\"numero\">39</region_id><region_name>Monterrey</region_name><doses_total tipo=\"numero\">500</doses_total><doses_used tipo=\"numero\">0</doses_used><doses_remaining tipo=\"numero\">500</doses_remaining><expires_on>2027-03-31</expires_on><vencido tipo=\"booleano\">false</vencido><scanned_by tipo=\"numero\">4</scanned_by><scanned_at>2026-11-01T18:10:00+00:00</scanned_at></lote_vacuna>\n"
                  }
                }
              }
            }
          },
          "200": {
            "description": "Ya estaba registrado con los mismos datos"
          },
          "401": {
            "description": "Falta token, es inválido, venció o la sesión se cerró"
          },
          "403": {
            "description": "El rol no puede usar esta ruta"
          },
          "503": {
            "description": "Redis no está disponible"
          },
          "400": {
            "description": "JSON o XML ilegible"
          },
          "409": {
            "description": "El código ya está con otros datos, se está registrando en otra petición, o la enfermedad o la región no existen"
          },
          "415": {
            "description": "Content-Type no soportado"
          },
          "422": {
            "description": "Algún campo inválido o desconocido"
          }
        }
      },
      "get": {
        "summary": "Buscar lotes",
        "operationId": "listar_lotes",
        "description": "Los más recientes primero. Después de escanear, la app busca con lot_code: si total es 0, el lote no está registrado. Los cuatro roles.",
        "parameters": [
          {
            "in": "query",
            "name": "lot_code",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "El código leído del QR"
          },
          {
            "in": "query",
            "name": "disease_id",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "region_id",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "total": 2,
                  "lotes": [
                    {
                      "id": 5,
                      "lot_code": "FL3239-2026",
                      "manufacturer": "Sanofi Pasteur",
                      "disease_id": 1,
                      "disease_name": "Influenza A",
                      "region_id": 39,
                      "region_name": "Monterrey",
                      "doses_total": 500,
                      "doses_used": 12,
                      "doses_remaining": 488,
                      "expires_on": "2027-03-31",
                      "vencido": false,
                      "scanned_by": 4,
                      "scanned_at": "2026-11-01T18:10:00+00:00"
                    },
                    {
                      "id": 4,
                      "lot_code": "EW0153",
                      "manufacturer": "Pfizer",
                      "disease_id": 1,
                      "disease_name": "Influenza A",
                      "region_id": 39,
                      "region_name": "Monterrey",
                      "doses_total": 200,
                      "doses_used": 200,
                      "doses_remaining": 0,
                      "expires_on": "2026-10-15",
                      "vencido": true,
                      "scanned_by": 4,
                      "scanned_at": "2026-09-20T15:30:00+00:00"
                    }
                  ]
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "listado"
                  }
                },
                "examples": {
                  "respuesta": {
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<listado><total tipo=\"numero\">2</total><lotes><lote><id tipo=\"numero\">5</id><lot_code>FL3239-2026</lot_code><manufacturer>Sanofi Pasteur</manufacturer><disease_id tipo=\"numero\">1</disease_id><disease_name>Influenza A</disease_name><region_id tipo=\"numero\">39</region_id><region_name>Monterrey</region_name><doses_total tipo=\"numero\">500</doses_total><doses_used tipo=\"numero\">12</doses_used><doses_remaining tipo=\"numero\">488</doses_remaining><expires_on>2027-03-31</expires_on><vencido tipo=\"booleano\">false</vencido><scanned_by tipo=\"numero\">4</scanned_by><scanned_at>2026-11-01T18:10:00+00:00</scanned_at></lote><lote><id tipo=\"numero\">4</id><lot_code>EW0153</lot_code><manufacturer>Pfizer</manufacturer><disease_id tipo=\"numero\">1</disease_id><disease_name>Influenza A</disease_name><region_id tipo=\"numero\">39</region_id><region_name>Monterrey</region_name><doses_total tipo=\"numero\">200</doses_total><doses_used tipo=\"numero\">200</doses_used><doses_remaining tipo=\"numero\">0</doses_remaining><expires_on>2026-10-15</expires_on><vencido tipo=\"booleano\">true</vencido><scanned_by tipo=\"numero\">4</scanned_by><scanned_at>2026-09-20T15:30:00+00:00</scanned_at></lote></lotes></listado>\n"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta token, es inválido, venció o la sesión se cerró"
          },
          "403": {
            "description": "El rol no puede usar esta ruta"
          },
          "503": {
            "description": "Redis no está disponible"
          },
          "422": {
            "description": "disease_id, region_id o limit inválidos"
          }
        }
      }
    },
    "/api/v1/vaccine-lots/{lote_id}": {
      "get": {
        "summary": "Consultar un lote",
        "operationId": "consultar_lote",
        "description": "Con sus dosis restantes y si ya caducó. Los cuatro roles.",
        "parameters": [
          {
            "in": "path",
            "name": "lote_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Id del lote"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": 5,
                  "lot_code": "FL3239-2026",
                  "manufacturer": "Sanofi Pasteur",
                  "disease_id": 1,
                  "disease_name": "Influenza A",
                  "region_id": 39,
                  "region_name": "Monterrey",
                  "doses_total": 500,
                  "doses_used": 12,
                  "doses_remaining": 488,
                  "expires_on": "2027-03-31",
                  "vencido": false,
                  "scanned_by": 4,
                  "scanned_at": "2026-11-01T18:10:00+00:00"
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "lote_vacuna"
                  }
                },
                "examples": {
                  "respuesta": {
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<lote_vacuna><id tipo=\"numero\">5</id><lot_code>FL3239-2026</lot_code><manufacturer>Sanofi Pasteur</manufacturer><disease_id tipo=\"numero\">1</disease_id><disease_name>Influenza A</disease_name><region_id tipo=\"numero\">39</region_id><region_name>Monterrey</region_name><doses_total tipo=\"numero\">500</doses_total><doses_used tipo=\"numero\">12</doses_used><doses_remaining tipo=\"numero\">488</doses_remaining><expires_on>2027-03-31</expires_on><vencido tipo=\"booleano\">false</vencido><scanned_by tipo=\"numero\">4</scanned_by><scanned_at>2026-11-01T18:10:00+00:00</scanned_at></lote_vacuna>\n"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta token, es inválido, venció o la sesión se cerró"
          },
          "403": {
            "description": "El rol no puede usar esta ruta"
          },
          "503": {
            "description": "Redis no está disponible"
          },
          "404": {
            "description": "No existe el lote"
          },
          "422": {
            "description": "Id inválido"
          }
        }
      }
    },
    "/api/v1/vaccine-lots/{lote_id}/doses": {
      "post": {
        "summary": "Aplicar dosis",
        "operationId": "aplicar_dosis",
        "description": "Descuenta doses del lote en un solo UPDATE condicionado: si no le quedan suficientes o ya caducó, 409 y no descuenta nada. Queda en la bitácora. CAPTURISTA y ADMINISTRADOR.",
        "parameters": [
          {
            "in": "path",
            "name": "lote_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Id del lote"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "doses"
                ],
                "properties": {
                  "doses": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "Cuántas dosis se aplicaron"
                  }
                }
              },
              "example": {
                "doses": 12
              }
            },
            "application/xml": {
              "schema": {
                "type": "object",
                "required": [
                  "doses"
                ],
                "properties": {
                  "doses": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "Cuántas dosis se aplicaron"
                  }
                },
                "xml": {
                  "name": "solicitud"
                }
              },
              "examples": {
                "peticion": {
                  "value": "<?xml version='1.0' encoding='utf-8'?>\n<solicitud><doses tipo=\"numero\">12</doses></solicitud>\n"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": 5,
                  "lot_code": "FL3239-2026",
                  "manufacturer": "Sanofi Pasteur",
                  "disease_id": 1,
                  "disease_name": "Influenza A",
                  "region_id": 39,
                  "region_name": "Monterrey",
                  "doses_total": 500,
                  "doses_used": 12,
                  "doses_remaining": 488,
                  "expires_on": "2027-03-31",
                  "vencido": false,
                  "scanned_by": 4,
                  "scanned_at": "2026-11-01T18:10:00+00:00"
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "xml": {
                    "name": "lote_vacuna"
                  }
                },
                "examples": {
                  "respuesta": {
                    "value": "<?xml version='1.0' encoding='utf-8'?>\n<lote_vacuna><id tipo=\"numero\">5</id><lot_code>FL3239-2026</lot_code><manufacturer>Sanofi Pasteur</manufacturer><disease_id tipo=\"numero\">1</disease_id><disease_name>Influenza A</disease_name><region_id tipo=\"numero\">39</region_id><region_name>Monterrey</region_name><doses_total tipo=\"numero\">500</doses_total><doses_used tipo=\"numero\">12</doses_used><doses_remaining tipo=\"numero\">488</doses_remaining><expires_on>2027-03-31</expires_on><vencido tipo=\"booleano\">false</vencido><scanned_by tipo=\"numero\">4</scanned_by><scanned_at>2026-11-01T18:10:00+00:00</scanned_at></lote_vacuna>\n"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta token, es inválido, venció o la sesión se cerró"
          },
          "403": {
            "description": "El rol no puede usar esta ruta"
          },
          "503": {
            "description": "Redis no está disponible"
          },
          "400": {
            "description": "JSON o XML ilegible"
          },
          "404": {
            "description": "No existe el lote"
          },
          "409": {
            "description": "No le quedan suficientes dosis o ya caducó"
          },
          "415": {
            "description": "Content-Type no soportado"
          },
          "422": {
            "description": "doses o id inválidos"
          }
        }
      }
    }
  }
}
